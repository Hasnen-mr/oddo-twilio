<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_duplicate_contact_hub_form" model="ir.ui.view">
        <field name="name">duplicate.contact.hub.form</field>
        <field name="model">duplicate.contact.hub</field>
        <field name="arch" type="xml">
            <form string="Reports &amp; Settings" create="0" delete="0" class="o_dup_hub_form">
                <sheet>
                    <field name="hub_section" invisible="1"/>
                    <field name="is_settings_user" invisible="1"/>
                    <field name="hub_nav" widget="duplicate_hub_nav" nolabel="1" class="o_dup_hub_nav_field"/>

                    <div class="o_dup_hub_panel" invisible="hub_section != 'merge_history'">
                        <div class="o_dup_contact_hero">
                            <div class="o_dup_contact_hero_icon">
                                <i class="fa fa-history" title="Merge history"/>
                            </div>
                            <div>
                                <h1>Merge History</h1>
                                <p>Audit log of every contact merge — survivor, archived duplicate, user, and date.</p>
                            </div>
                        </div>
                        <field name="merge_line_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="create_date"/>
                                <field name="survivor_name"/>
                                <field name="merged_name"/>
                                <field name="survivor_id"/>
                                <field name="merged_id" optional="hide"/>
                                <field name="user_id"/>
                            </list>
                        </field>
                    </div>

                    <div class="o_dup_hub_panel" invisible="hub_section != 'scan_reports'">
                        <div class="o_dup_contact_hero">
                            <div class="o_dup_contact_hero_icon">
                                <i class="fa fa-bar-chart" title="Scan reports"/>
                            </div>
                            <div>
                                <h1>Scan Reports</h1>
                                <p>Manual and automatic duplicate scans with progress, pair counts, and timestamps.</p>
                            </div>
                        </div>
                        <field name="scan_line_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="name"/>
                                <field name="source"/>
                                <field name="state"/>
                                <field name="progress" widget="progressbar"/>
                                <field name="processed_contacts"/>
                                <field name="total_contacts"/>
                                <field name="pairs_created"/>
                                <field name="pairs_updated"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="user_id"/>
                            </list>
                        </field>
                    </div>

                    <div class="o_dup_hub_panel" invisible="hub_section != 'settings'">
                        <div class="o_dup_contact_hero">
                            <div class="o_dup_contact_hero_icon">
                                <i class="fa fa-cog" title="Settings"/>
                            </div>
                            <div>
                                <h1>Settings</h1>
                                <p>Matching rules, thresholds, automatic scans, and API duplicate protection.</p>
                            </div>
                        </div>

                        <div class="o_dup_hub_settings_layout">
                            <div class="o_dup_hub_settings_main">
                                <div class="o_dup_contact_section_title">Matching rules</div>
                                <p class="o_dup_hub_settings_hint">Choose which fields are used to detect duplicate contacts.</p>
                                <div class="o_dup_hub_settings_list">
                                    <div class="o_dup_hub_setting_row">
                                        <div class="o_dup_hub_setting_text">
                                            <label for="duplicate_match_name" string="Match Name"/>
                                            <span>Fuzzy match on contact and person names</span>
                                        </div>
                                        <field name="duplicate_match_name" nolabel="1" widget="boolean_toggle"/>
                                    </div>
                                    <div class="o_dup_hub_setting_row">
                                        <div class="o_dup_hub_setting_text">
                                            <label for="duplicate_match_phone" string="Match Phone"/>
                                            <span>Normalize +91, spaces, and formatting variants</span>
                                        </div>
                                        <field name="duplicate_match_phone" nolabel="1" widget="boolean_toggle"/>
                                    </div>
                                    <div class="o_dup_hub_setting_row">
                                        <div class="o_dup_hub_setting_text">
                                            <label for="duplicate_match_email" string="Match Email"/>
                                            <span>Case-insensitive email comparison</span>
                                        </div>
                                        <field name="duplicate_match_email" nolabel="1" widget="boolean_toggle"/>
                                    </div>
                                    <div class="o_dup_hub_setting_row">
                                        <div class="o_dup_hub_setting_text">
                                            <label for="duplicate_match_vat" string="Match Tax ID / GST / VAT"/>
                                            <span>Exact match on tax identifiers</span>
                                        </div>
                                        <field name="duplicate_match_vat" nolabel="1" widget="boolean_toggle"/>
                                    </div>
                                    <div class="o_dup_hub_setting_row">
                                        <div class="o_dup_hub_setting_text">
                                            <label for="duplicate_match_company" string="Match Company"/>
                                            <span>Fuzzy company name matching</span>
                                        </div>
                                        <field name="duplicate_match_company" nolabel="1" widget="boolean_toggle"/>
                                    </div>
                                    <div class="o_dup_hub_setting_row">
                                        <div class="o_dup_hub_setting_text">
                                            <label for="duplicate_match_website" string="Match Website"/>
                                            <span>Compare normalized website domains</span>
                                        </div>
                                        <field name="duplicate_match_website" nolabel="1" widget="boolean_toggle"/>
                                    </div>
                                    <div class="o_dup_hub_setting_row">
                                        <div class="o_dup_hub_setting_text">
                                            <label for="duplicate_match_address" string="Match Address"/>
                                            <span>Street and ZIP required — city alone is ignored</span>
                                        </div>
                                        <field name="duplicate_match_address" nolabel="1" widget="boolean_toggle"/>
                                    </div>
                                    <div class="o_dup_hub_setting_row">
                                        <div class="o_dup_hub_setting_text">
                                            <label for="duplicate_match_ai" string="AI Similarity"/>
                                            <span>Reserved for future AI-assisted matching</span>
                                        </div>
                                        <field name="duplicate_match_ai" nolabel="1" widget="boolean_toggle"/>
                                    </div>
                                </div>

                                <div class="o_dup_contact_section_title">Thresholds &amp; automation</div>
                                <div class="o_dup_cfg_card o_dup_hub_settings_card">
                                    <group>
                                        <group>
                                            <field name="duplicate_review_threshold"/>
                                            <field name="duplicate_min_threshold"/>
                                            <field name="duplicate_scan_limit"/>
                                        </group>
                                        <group>
                                            <field name="duplicate_auto_merge"/>
                                            <field name="duplicate_cron_interval"/>
                                        </group>
                                    </group>
                                    <div class="o_dup_cfg_actions">
                                        <button name="action_run_duplicate_scan" type="object" string="Run Scan Now" class="btn btn-secondary" icon="fa-refresh"/>
                                    </div>
                                </div>

                                <div class="o_dup_contact_section_title">API &amp; import</div>
                                <div class="o_dup_hub_settings_list">
                                    <div class="o_dup_hub_setting_row">
                                        <div class="o_dup_hub_setting_text">
                                            <label for="duplicate_api_block" string="Block API Duplicates"/>
                                            <span>Stop creating contacts when a duplicate is found via API</span>
                                        </div>
                                        <field name="duplicate_api_block" nolabel="1" widget="boolean_toggle"/>
                                    </div>
                                    <div class="o_dup_hub_setting_row">
                                        <div class="o_dup_hub_setting_text">
                                            <label for="duplicate_api_warn" string="Warn on API Duplicates"/>
                                            <span>Log a warning when probable duplicates are detected</span>
                                        </div>
                                        <field name="duplicate_api_warn" nolabel="1" widget="boolean_toggle"/>
                                    </div>
                                </div>

                                <div class="o_dup_cfg_actions">
                                    <button name="action_save_settings" type="object" string="Save Settings" class="btn btn-primary" icon="fa-save"/>
                                </div>
                            </div>

                            <aside class="o_dup_hub_settings_aside">
                                <div class="o_dup_twilio_ad">
                                    <div class="o_dup_twilio_ad_badge">Recommended</div>
                                    <div class="o_dup_twilio_ad_icon">
                                        <i class="fa fa-phone" title="Twilio Calling"/>
                                    </div>
                                    <h3>Twilio Calling System</h3>
                                    <p>Call contacts from Odoo with VoIP softphone, auto dialer, and AI transcription.</p>
                                    <ul class="o_dup_twilio_ad_features">
                                        <li><i class="fa fa-check" title="Feature"/> Click-to-call from Contacts</li>
                                        <li><i class="fa fa-check" title="Feature"/> Auto dialer campaigns</li>
                                        <li><i class="fa fa-check" title="Feature"/> CRM call logs</li>
                                    </ul>
                                    <a href="https://apps.odoo.com/apps/modules/19.0/twilio_dialer"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       role="button"
                                       class="btn btn-primary o_dup_twilio_ad_btn">
                                        <i class="fa fa-external-link" title="Open App Store"/>
                                        Get Twilio Module
                                    </a>
                                    <span class="o_dup_twilio_ad_note">Opens Odoo Apps in a new tab</span>
                                </div>
                            </aside>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_duplicate_contact_hub" model="ir.actions.server">
        <field name="name">Reports &amp; Settings</field>
        <field name="model_id" ref="model_duplicate_contact_hub"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_hub()</field>
    </record>

</odoo>
