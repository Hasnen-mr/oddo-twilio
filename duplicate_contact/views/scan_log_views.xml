<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_duplicate_contact_scan_log_list" model="ir.ui.view">
        <field name="name">duplicate.contact.scan.log.list</field>
        <field name="model">duplicate.contact.scan.log</field>
        <field name="arch" type="xml">
            <list string="Scan Reports" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="source"/>
                <field name="state"/>
                <field name="progress"/>
                <field name="processed_contacts"/>
                <field name="total_contacts"/>
                <field name="pairs_created"/>
                <field name="pairs_updated"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_duplicate_contact_scan_log_form" model="ir.ui.view">
        <field name="name">duplicate.contact.scan.log.form</field>
        <field name="model">duplicate.contact.scan.log</field>
        <field name="arch" type="xml">
            <form string="Scan Report" create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source"/>
                            <field name="progress"/>
                            <field name="processed_contacts"/>
                            <field name="total_contacts"/>
                            <field name="batch_size"/>
                        </group>
                        <group>
                            <field name="pairs_created"/>
                            <field name="pairs_updated"/>
                            <field name="pairs_skipped"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_duplicate_contact_scan_logs" model="ir.actions.act_window">
        <field name="name">Scan Reports</field>
        <field name="res_model">duplicate.contact.scan.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
