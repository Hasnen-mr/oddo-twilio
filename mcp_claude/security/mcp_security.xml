<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_mcp" model="ir.module.category">
            <field name="name">MCP Claude</field>
            <field name="description">Security access levels for MCP Server management.</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_mcp_user" model="res.groups">
            <field name="name">MCP User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_mcp_approver" model="res.groups">
            <field name="name">MCP Approval Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_mcp_user'))]"/>
        </record>

        <record id="group_mcp_admin" model="res.groups">
            <field name="name">MCP Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_mcp_approver'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mcp_admin'))]"/>
        </record>
    </data>
</odoo>
