<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mcp_claude.AIBubbleContainer">
        <t t-if="!state.isHiddenOnClaude &amp;&amp; !state.isBubbleDismissed &amp;&amp; !state.isBubbleDisabled">
            <div class="o_mcp_ai_bubble_wrapper">
                <t t-if="state.isOpen">
                    <AIChatWindow onClose.bind="closeWindow"/>
                </t>
                <AIBubbleTrigger isOpen="state.isOpen" onClick.bind="toggleWindow" onDismiss.bind="dismissBubble"/>
            </div>
        </t>

        <!-- Global Email & Data Verification Modal (Prompt every 5-10s if unverified) -->
        <t t-if="state.showGlobalVerifyModal &amp;&amp; !state.isEmailVerified">
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.65); z-index: 1060;" role="dialog">
                <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
                    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                        
                        <!-- Modal Header with Close -->
                        <div class="modal-header border-0 pb-0 pt-3.5 px-4 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <div class="p-1.5 rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: #fff9f6; color: #D97757;">
                                    <i class="fa fa-envelope-o"/>
                                </div>
                                <h6 class="modal-title fw-bold text-dark mb-0" style="font-size: 15px;">Email Verification Required</h6>
                            </div>
                            <button type="button" class="btn-close" aria-label="Close" t-on-click="() => this.closeGlobalVerifyModal()" style="cursor: pointer;"/>
                        </div>

                        <!-- Modal Body -->
                        <div class="modal-body p-4 text-center">
                            <p class="text-muted small mb-3" style="font-size: 13px;">
                                Please verify your email and complete registration to unlock all Claude MCP features.
                            </p>

                            <!-- STEP 1: Enter Name, Email & Phone -->
                            <t t-if="!state.globalOtpSent">
                                <div class="p-3 bg-light rounded-3 border mb-3 text-start">
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold text-dark mb-1">Full Name</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white"><i class="fa fa-user text-muted"/></span>
                                            <input type="text" class="form-control" placeholder="John Doe" t-att-value="this.state.globalUserName" t-on-input="(ev) => this.state.globalUserName = ev.target.value"/>
                                        </div>
                                    </div>

                                    <div class="mb-2">
                                        <label class="form-label small fw-bold text-dark mb-1">Work Email <span class="text-danger">*</span></label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white"><i class="fa fa-envelope text-muted"/></span>
                                            <input type="email" class="form-control" placeholder="you@company.com" t-att-value="this.state.globalUserEmail" t-on-input="(ev) => this.state.globalUserEmail = ev.target.value"/>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-dark mb-1">Phone Number <span class="text-danger">*</span></label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white"><i class="fa fa-phone text-muted"/></span>
                                            <input type="tel" class="form-control" placeholder="+1 (555) 000-0000" t-att-value="this.state.globalUserPhone" t-on-input="(ev) => this.state.globalUserPhone = ev.target.value"/>
                                        </div>
                                    </div>

                                    <button type="button" 
                                            class="btn btn-primary w-100 fw-bold text-white py-2 shadow-sm"
                                            t-on-click="() => this.sendGlobalRegistrationData(false)"
                                            t-att-disabled="state.globalSendingOtp || !state.globalUserEmail || !state.globalUserPhone">
                                        <t t-if="state.globalSendingOtp">
                                            <i class="fa fa-spinner fa-spin me-1"/> Sending Verification Code...
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-paper-plane me-1"/> Send 6-Digit Code
                                        </t>
                                    </button>
                                </div>
                            </t>

                            <!-- STEP 2: Enter 6-Digit OTP Code -->
                            <t t-else="">
                                <div class="p-3 bg-light rounded-3 border mb-3 text-start">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="text-muted small" style="font-size: 11.5px;">Code sent to: <strong class="text-dark" t-esc="state.globalUserEmail"/></span>
                                        <button type="button" class="btn btn-link p-0 text-decoration-none small fw-semibold" style="color: #D97757;" t-on-click="() => this.changeGlobalRegistrationData()">
                                            <i class="fa fa-pencil me-1"/>Change
                                        </button>
                                    </div>

                                    <label class="form-label small fw-bold text-dark mb-1 text-center w-100" style="font-size: 11px; letter-spacing: 0.05em;">ENTER 6-DIGIT CODE</label>
                                    <input type="text"
                                           class="form-control text-center font-monospace fw-bold fs-4 mb-2"
                                           placeholder="123456"
                                           maxlength="6"
                                           autofocus="autofocus"
                                           style="letter-spacing: 0.25em;"
                                           t-att-value="this.state.globalOtp" t-on-input="(ev) => this.state.globalOtp = ev.target.value"
                                           t-on-keydown="(ev) => this.onGlobalOtpKeydown(ev)"/>

                                    <button type="button" 
                                            class="btn btn-primary w-100 fw-bold text-white py-2 shadow-sm mb-2"
                                            t-on-click="() => this.verifyGlobalOtp()"
                                            t-att-disabled="state.globalVerifyingOtp || !state.globalOtp">
                                        <t t-if="state.globalVerifyingOtp">
                                            <i class="fa fa-spinner fa-spin me-1"/> Verifying Code...
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-check-circle me-1"/> Verify Code
                                        </t>
                                    </button>

                                    <div class="text-center pt-1">
                                        <button type="button"
                                                class="btn btn-link p-0 text-decoration-none fw-semibold"
                                                style="font-size: 0.85rem; color: #D97757;"
                                                t-att-disabled="state.globalSendingOtp || state.globalVerifyingOtp"
                                                t-on-click="() => this.sendGlobalRegistrationData(true)">
                                            <t t-if="state.globalSendingOtp">
                                                <i class="fa fa-spinner fa-spin me-1"/> Sending new code...
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-refresh me-1"/> Resend Email
                                            </t>
                                        </button>
                                    </div>
                                </div>
                            </t>

                            <t t-if="state.globalOtpSuccess">
                                <div class="alert alert-success py-2 px-3 small text-center mb-2" role="alert" t-esc="state.globalOtpSuccess"/>
                            </t>
                            <t t-if="state.globalOtpError">
                                <div class="alert alert-danger py-2 px-3 small text-center mb-2" role="alert" t-esc="state.globalOtpError"/>
                            </t>

                            <div class="text-muted small" style="font-size: 11px;">
                                <i class="fa fa-info-circle me-1"/>Closing this dialog will prompt you again in 8 seconds until verified.
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </t>
    </t>

    <t t-name="mcp_claude.AIBubbleTrigger">
        <div class="o_mcp_ai_bubble_trigger_container position-relative">
            <button t-if="!props.isOpen"
                    type="button"
                    class="o_mcp_ai_bubble_close"
                    title="Hide Claude bubble for this session"
                    t-on-click.stop="() => this.props.onDismiss()">
                <i class="fa fa-times"/>
            </button>
            <button class="o_mcp_ai_bubble_trigger" t-on-click="() => this.props.onClick()" title="Claude AI" type="button">
                <t t-if="props.isOpen">
                    <i class="fa fa-times" style="color: #D97757; font-size: 20px;"/>
                </t>
                <t t-else="">
                    <svg class="claude-icon-svg" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L14.4 8.3L21 9.3L16.2 14L17.3 20.5L12 17.4L6.7 20.5L7.8 14L3 9.3L9.6 8.3L12 2Z" fill="#D97757"/>
                    </svg>
                </t>
            </button>
        </div>
    </t>
</templates>
