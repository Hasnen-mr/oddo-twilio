<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mcp_claude.AIChatSkeleton">
        <div t-attf-class="o_mcp_skeleton_container d-flex flex-column gap-3 p-3 #{props.isOverlay ? 'o_mcp_skeleton_overlay_content' : 'w-100 h-100'}">
            <t t-foreach="placeholders" t-as="item" t-key="item.id">
                <div t-attf-class="d-flex flex-column max-w-85 #{item.role === 'user' ? 'align-self-end text-end' : 'align-self-start text-start'}">
                    <div class="d-flex align-items-center gap-2 mb-1" t-if="item.role === 'assistant'">
                        <div class="o_mcp_skeleton_avatar rounded-circle"/>
                        <div class="o_mcp_skeleton_line rounded-pill" style="width: 60px; height: 10px;"/>
                    </div>
                    <div t-attf-class="p-3 rounded-4 #{item.role === 'user' ? 'bg-primary-subtle' : 'bg-light border'}">
                        <div class="o_mcp_skeleton_line rounded-pill mb-2" t-attf-style="width: #{item.width}; height: 14px;"/>
                        <t t-if="item.lines > 1">
                            <div class="o_mcp_skeleton_line rounded-pill" style="width: 50%; height: 12px;"/>
                        </t>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
