                        <path d="M12 2L14.4 8.3L21 9.3L16.2 14L17.3 20.5L12 17.4L6.7 20.5L7.8 14L3 9.3L9.6 8.3L12 2Z" fill="#D97757"/>
                    </svg>
                    <span class="d-none d-md-inline fw-bold text-dark fs-7" style="font-size: 13px; color: #1F1E1B !important;">Claude AI</span>
                </button>
            </div>
        </t>
    </t>

</templates>
