<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mcp_claude.AISystrayItem">
        <t t-if="!state.isHiddenOnClaude">
            <div class="o_mcp_ai_systray_item position-relative d-flex align-items-center">
