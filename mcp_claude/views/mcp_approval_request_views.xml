<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_approval_request_list" model="ir.ui.view">
        <field name="name">mcp.approval.request.list</field>
        <field name="model">mcp.approval.request</field>
        <field name="arch" type="xml">
            <tree string="Approval Requests" decoration-warning="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="tool_name"/>
                <field name="requested_by_user_id"/>
                <field name="state"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_mcp_approval_request_form" model="ir.ui.view">
        <field name="name">mcp.approval.request.form</field>
        <field name="model">mcp.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <button name="action_approve" string="Approve Execution" type="object" class="btn-success" invisible="state != 'pending'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Execution Context">
                            <field name="tool_name" readonly="1"/>
                            <field name="requested_by_user_id" readonly="1"/>
                        </group>
                        <group string="Approval Details">
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload Arguments">
                            <field name="arguments" readonly="1" placeholder="Request arguments JSON..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_approval_request_search" model="ir.ui.view">
        <field name="name">mcp.approval.request.search</field>
        <field name="model">mcp.approval.request</field>
        <field name="arch" type="xml">
            <search string="Search Approval Requests">
                <field name="name"/>
                <field name="tool_name"/>
                <field name="requested_by_user_id"/>
                <filter string="Pending Approval" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Requested By" name="group_user" context="{'group_by': 'requested_by_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcp_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">mcp.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mcp_approval_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Pending Tool Approvals!
            </p>
            <p>
                High-risk tool execution calls awaiting human review will appear here.
            </p>
        </field>
    </record>
</odoo>
