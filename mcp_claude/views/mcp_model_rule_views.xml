<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_model_rule_list" model="ir.ui.view">
        <field name="name">mcp.model.rule.list</field>
        <field name="model">mcp.model.rule</field>
        <field name="arch" type="xml">
            <tree string="Model Permissions" decoration-success="active == True">
                <field name="model_id"/>
                <field name="allow_read"/>
                <field name="allow_create"/>
                <field name="allow_write"/>
                <field name="allow_unlink"/>
                <field name="allow_call_method"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mcp_model_rule_form" model="ir.ui.view">
        <field name="name">mcp.model.rule.form</field>
        <field name="model">mcp.model.rule</field>
        <field name="arch" type="xml">
            <form string="Model Permission Rule">
                <sheet>
                    <group>
                        <group string="Model Selection">
                            <field name="model_id"/>
                            <field name="active"/>
                        </group>
                        <group string="CRUD &amp; Method Permissions">
                            <field name="allow_read"/>
                            <field name="allow_create"/>
                            <field name="allow_write"/>
                            <field name="allow_unlink"/>
                            <field name="allow_call_method"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_model_rule_search" model="ir.ui.view">
        <field name="name">mcp.model.rule.search</field>
        <field name="model">mcp.model.rule</field>
        <field name="arch" type="xml">
            <search string="Search Model Rules">
                <field name="model_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Allow Read" name="allow_read" domain="[('allow_read', '=', True)]"/>
                <filter string="Allow Create" name="allow_create" domain="[('allow_create', '=', True)]"/>
                <filter string="Allow Write" name="allow_write" domain="[('allow_write', '=', True)]"/>
                <filter string="Allow Unlink" name="allow_unlink" domain="[('allow_unlink', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_mcp_model_rule" model="ir.actions.act_window">
        <field name="name">Model Permissions</field>
        <field name="res_model">mcp.model.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mcp_model_rule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define Model Access Control Rules for AI!
            </p>
            <p>
                Configure fine-grained ORM Read, Create, Update, Delete, and Method Call permissions per model.
            </p>
        </field>
    </record>
</odoo>
