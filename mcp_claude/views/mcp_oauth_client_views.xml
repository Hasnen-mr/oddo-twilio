<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_oauth_client_list" model="ir.ui.view">
        <field name="name">mcp.oauth.client.list</field>
        <field name="model">mcp.oauth.client</field>
        <field name="arch" type="xml">
            <tree string="OAuth Clients" decoration-success="active == True">
                <field name="name"/>
                <field name="client_id"/>
                <field name="client_type"/>
                <field name="redirect_uris"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mcp_oauth_client_form" model="ir.ui.view">
        <field name="name">mcp.oauth.client.form</field>
        <field name="model">mcp.oauth.client</field>
        <field name="arch" type="xml">
            <form string="OAuth 2.0 Client">
                <sheet>
                    <widget name="web_ribbon" title="Disabled" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Client App Name (e.g. Claude Desktop)..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Client Identifiers">
                            <field name="client_id"/>
                            <field name="client_type"/>
                            <field name="active"/>
                        </group>
                        <group string="OAuth Settings">
                            <field name="redirect_uris"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_oauth_client_search" model="ir.ui.view">
        <field name="name">mcp.oauth.client.search</field>
        <field name="model">mcp.oauth.client</field>
        <field name="arch" type="xml">
            <search string="Search OAuth Clients">
                <field name="name"/>
                <field name="client_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <group>
                    <filter string="Client Type" name="group_type" context="{'group_by': 'client_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcp_oauth_client" model="ir.actions.act_window">
        <field name="name">OAuth Clients</field>
        <field name="res_model">mcp.oauth.client</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mcp_oauth_client_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register an OAuth 2.0 Client Application!
            </p>
            <p>
                Manage registered AI Desktop clients, redirect URIs, and authentication credentials.
            </p>
        </field>
    </record>
</odoo>
