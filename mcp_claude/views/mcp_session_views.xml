<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_session_list" model="ir.ui.view">
        <field name="name">mcp.session.list</field>
        <field name="model">mcp.session</field>
        <field name="arch" type="xml">
            <tree string="Active Sessions" decoration-success="active == True" decoration-muted="active == False">
                <field name="session_token"/>
                <field name="user_id"/>
                <field name="client_name"/>
                <field name="expires_at"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mcp_session_form" model="ir.ui.view">
        <field name="name">mcp.session.form</field>
        <field name="model">mcp.session</field>
        <field name="arch" type="xml">
            <form string="Client Session">
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-secondary" invisible="active"/>
                    <group>
                        <group string="Session Information">
                            <field name="session_token" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="client_name" readonly="1"/>
                        </group>
                        <group string="Timing &amp; Status">
                            <field name="expires_at" readonly="1"/>
                            <field name="active" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_session_search" model="ir.ui.view">
        <field name="name">mcp.session.search</field>
        <field name="model">mcp.session</field>
        <field name="arch" type="xml">
            <search string="Search Sessions">
                <field name="session_token"/>
                <field name="user_id"/>
                <field name="client_name"/>
                <filter string="Active Sessions" name="active" domain="[('active', '=', True)]"/>
                <group>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Client App" name="group_client" context="{'group_by': 'client_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcp_session" model="ir.actions.act_window">
        <field name="name">Active Sessions</field>
        <field name="res_model">mcp.session</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mcp_session_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Active AI Sessions!
            </p>
            <p>
                Connected AI client sessions (Claude Desktop, Cursor, ChatGPT, etc.) will be tracked here.
            </p>
        </field>
    </record>
</odoo>
