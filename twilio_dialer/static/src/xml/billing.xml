<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="twilio_dialer.BillingDashboard">
        <div class="o_twilio_billing">
            <t t-if="state.loading"><div class="o_twilio_billing_skeleton"/></t>
            <t t-elif="state.error">
                <div class="alert alert-warning"><t t-esc="state.error"/></div>
                <button class="btn btn-primary" t-on-click="refresh">Refresh</button>
            </t>
            <t t-else="">
                <t t-call="twilio_dialer.BillingKpis"/>
                <t t-call="twilio_dialer.BillingActions"/>
            </t>
        </div>
    </t>

    <t t-name="twilio_dialer.BillingKpis">
        <section class="o_billing_kpis">
            <div class="o_billing_kpi">
                <i class="fa fa-wallet"/>
                <span>Credits Remaining</span>
                <b t-esc="state.billing.remaining"/>
                <small>Available for calls</small>
            </div>
            <div class="o_billing_kpi">
                <i class="fa fa-coins"/>
                <span>Total Credits</span>
                <b t-esc="state.billing.limit"/>
                <small>Current allowance</small>
            </div>
            <div class="o_billing_kpi">
                <i class="fa fa-phone"/>
                <span>Calls Used</span>
                <b t-esc="state.billing.usage"/>
                <small>
                    <t t-esc="state.billing.incoming"/> incoming ·
                    <t t-esc="state.billing.outgoing"/> outgoing
                </small>
            </div>
            <div class="o_billing_kpi">
                <i class="fa fa-chart-line"/>
                <span>Usage Percentage</span>
                <b><t t-esc="Math.round(progress)"/>%</b>
                <small>Of current allowance</small>
            </div>
        </section>
    </t>

    <t t-name="twilio_dialer.BillingActions">
        <section class="o_billing_glass o_billing_actions">
            <div>
                <span class="o_billing_eyebrow">ACTIONS</span>
                <h2>Manage Billing</h2>
            </div>
            <button class="btn o_billing_btn" t-on-click="refresh">
                <i class="fa fa-refresh"/> Refresh
            </button>
            <button class="btn o_billing_btn o_billing_btn--primary"
                    t-att-disabled="!state.billing.topUpUrl"
                    t-on-click="() => openUrl(state.billing.topUpUrl)">
                <i class="fa fa-arrow-up"/> Top Up Credits
            </button>
            <button class="btn o_billing_btn"
                    t-att-disabled="!state.billing.billingUrl"
                    t-on-click="() => openUrl(state.billing.billingUrl)">
                <i class="fa fa-external-link"/> Billing Portal
            </button>
            <button class="btn o_billing_btn" disabled="disabled">
                <i class="fa fa-question-circle"/> Help
            </button>
        </section>
    </t>
</templates>
