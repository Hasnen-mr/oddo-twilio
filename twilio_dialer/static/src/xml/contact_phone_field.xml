<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="twilio_dialer.ContactCallButton">
        <button type="button"
                class="o_twilio_contact_call_button"
                t-att-disabled="!phone"
                t-att-title="phone ? 'Open Twilio Dialer' : 'This contact does not have a phone number.'"
                t-on-click.stop="openDialer">
            <i class="fa fa-phone" aria-label="Call"/>
        </button>
    </t>

    <t t-inherit="web.FormPhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]" position="inside">
            <t t-if="props.enableDialerCall">
                <ContactCallButton record="props.record" name="props.name"/>
            </t>
        </xpath>
    </t>

</templates>
