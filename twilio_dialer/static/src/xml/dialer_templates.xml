<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">



    <t t-name="twilio_dialer.DialerSystray">
        <button type="button"
                class="o_dialer_toggle_btn"
                t-att-class="{ 'o_dialer_toggle_btn--open': state.isOpen }"
                title="Twilio Call Auto Dialer"
                aria-label="Twilio Call Auto Dialer"
                t-on-click="togglePanel">
            <span class="o_dialer_toggle_visual" aria-hidden="true">
                <span class="o_dialer_toggle_ring o_dialer_toggle_ring--outer"/>
                <span class="o_dialer_toggle_ring o_dialer_toggle_ring--inner"/>
                <span class="o_dialer_toggle_core">
                    <i class="fa fa-phone" role="img"/>
                </span>
            </span>
            <span class="o_dialer_toggle_label">Open Dialer</span>
        </button>
        <div class="o_dialer_panel" t-att-class="state.isOpen ? 'o_dialer_panel--open' : ''">
            <t t-if="state.isOpen">
                <DialerPopup onClose.bind="closePanel"
                             phone="state.phone"
                             fromNumber="state.fromNumber"
                             partnerId="state.partnerId"
                             partnerName="state.partnerName"
                             requestId="state.requestId"/>
            </t>
        </div>
    </t>

    <t t-name="twilio_dialer.DialerPopup">
        <div class="o_dialer_popup" t-on-click="closeAllDropdowns">

            <!-- Header -->
            <div class="o_dialer_header">
                <div class="o_dialer_header_left">
                    <i class="fa fa-phone-o o_dialer_header_icon"/>
                    <span class="o_dialer_title">Twilio Call Auto Dialer</span>
                    <span class="o_dialer_status_badge" t-att-class="'o_dialer_status_badge--' + statusClass">
                        <span class="o_dialer_status_dot"/>
                        <t t-esc="statusLabel"/>
                    </span>
                </div>
                <button
                    type="button"
                    class="o_dialer_close_btn"
                    t-on-click="closePopup"
                    title="Close">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <div class="o_dialer_body">

                <!-- Dialpad tab / Incoming Call View -->
                <t t-if="state.activeTab === 'dialpad'">
                    <t t-if="isIncoming and !state.showIncomingKeypad">
                        <!-- Modern Incoming Call Screen (Default View) -->
                        <div class="o_dialer_incoming_view">
                            <div class="o_dialer_incoming_hero">
                                <div class="o_dialer_incoming_avatar">
                                    <i class="fa fa-user"/>
                                </div>
                                <h2 class="o_dialer_incoming_caller" t-esc="fullIncomingDisplayNumber"/>
                                <div class="o_dialer_incoming_location" t-if="state.selectedCountry">
                                    <span class="o_dialer_incoming_flag" t-esc="state.selectedCountry.flag"/>
                                    <span class="o_dialer_incoming_country_name" t-esc="state.selectedCountry.name"/>
                                </div>
                                <div class="o_dialer_incoming_status_row">
                                    <span class="o_dialer_incoming_badge">
                                        <span class="o_dialer_incoming_dot"/>
                                        Incoming
                                    </span>
                                    <span class="o_dialer_incoming_timer" t-esc="formattedCallDuration"/>
                                </div>
                            </div>

                            <div class="o_dialer_incoming_info_card">
                                <i class="fa fa-info-circle o_dialer_incoming_info_icon"/>
                                <span>You have an incoming call</span>
                            </div>

                            <div class="o_dialer_incoming_actions">
                                <button
                                    type="button"
                                    class="o_dialer_incoming_btn o_dialer_incoming_btn--accept"
                                    t-on-click="onAcceptCall"
                                    title="Accept Call"
                                    aria-label="Accept Call">
                                    <i class="fa fa-phone"/>
                                    <span>Accept</span>
                                </button>
                                <button
                                    type="button"
                                    class="o_dialer_incoming_btn o_dialer_incoming_btn--decline"
                                    t-on-click="onRejectCall"
                                    title="Decline Call"
                                    aria-label="Decline Call">
                                    <i class="fa fa-phone"/>
                                    <span>Decline</span>
                                </button>
                            </div>

                            <div class="o_dialer_incoming_secondary_row">
                                <button
                                    type="button"
                                    class="o_dialer_incoming_keypad_toggle_btn"
                                    t-on-click="toggleIncomingKeypad">
                                    <i class="fa fa-keyboard-o"/>
                                    <span>Dial Pad</span>
                                </button>
                            </div>
                        </div>
                    </t>

                    <t t-else="">
                        <!-- Keypad View (Shown on click of Dial Pad or for normal outgoing calling) -->
                        <div class="o_dialer_keypad_view">
                            <div class="o_dialer_incoming_back_row" t-if="isIncoming and state.showIncomingKeypad">
                                <button type="button" class="o_dialer_back_btn" t-on-click="backToIncomingView">
                                    <i class="fa fa-arrow-left"/>
                                    <span>Back</span>
                                </button>
                            </div>

                            <div class="o_dialer_section" t-if="!isIncoming">
                                <label class="o_dialer_label">Calling From</label>
                                <div class="o_dialer_caller_row">
                                    <div class="o_dialer_caller_dropdown_container">
                                        <button
                                            type="button"
                                            class="o_dialer_caller_dropdown_btn"
                                            t-on-click.stop="toggleCallerDropdown">
                                            <span class="o_dialer_caller_number" t-esc="formattedCallerDisplay"/>
                                            <i class="fa fa-chevron-down o_dialer_dropdown_arrow"/>
                                        </button>
                                        <div class="o_dialer_caller_list" t-if="state.showCallerDropdown">
                                            <t t-foreach="state.callerNumbers" t-as="caller" t-key="caller.number">
                                                <button
                                                    type="button"
                                                    class="o_dialer_caller_option"
                                                    t-att-class="{ 'o_dialer_caller_option--active': state.selectedCaller and state.selectedCaller.number === caller.number }"
                                                    t-on-click.stop="() => this.selectCaller(caller)">
                                                    <span class="o_dialer_caller_option_name" t-if="caller.friendlyName" t-esc="caller.friendlyName"/>
                                                    <span class="o_dialer_caller_option_number" t-esc="caller.number"/>
                                                </button>
                                            </t>
                                        </div>
                                    </div>
                                    <button type="button" class="o_dialer_icon_btn" title="Refresh numbers" t-on-click.stop="_loadConfiguredPhoneNumber">
                                        <i class="fa fa-refresh"/>
                                    </button>
                                    <button type="button" class="o_dialer_icon_btn o_dialer_icon_btn--disabled" disabled="true" title="Add number">
                                        <i class="fa fa-plus"/>
                                    </button>
                                </div>
                            </div>

                            <div class="o_dialer_section">
                                <div class="o_dialer_phone_entry">
                                    <div class="o_dialer_country_container">
                                        <button
                                            type="button"
                                            class="o_dialer_country_btn"
                                            t-att-disabled="isCallActive or isIncoming"
                                            t-on-click.stop="toggleCountryDropdown">
                                            <span class="o_dialer_country_flag" t-esc="state.selectedCountry.flag"/>
                                            <span class="o_dialer_country_code" t-esc="state.selectedCountry.code"/>
                                            <i class="fa fa-caret-down" t-if="!isCallActive and !isIncoming"/>
                                        </button>
                                        <div class="o_dialer_country_list" t-if="state.showCountryDropdown and !isCallActive and !isIncoming">
                                            <div class="o_dialer_country_search">
                                                <input
                                                    type="text"
                                                    placeholder="Search countries..."
                                                    class="o_dialer_country_search_input"
                                                    t-on-input="onCountrySearch"/>
                                            </div>
                                            <div class="o_dialer_country_options">
                                                <t t-foreach="filteredCountries" t-as="country" t-key="country.label">
                                                    <button
                                                        type="button"
                                                        class="o_dialer_country_option"
                                                        t-att-class="{ 'o_dialer_country_option--active': state.selectedCountry.label === country.label }"
                                                        t-on-click.stop="() => this.selectCountry(country)">
                                                        <span class="o_dialer_country_option_flag" t-esc="country.flag"/>
                                                        <span class="o_dialer_country_option_name" t-esc="country.name"/>
                                                        <span class="o_dialer_country_option_code" t-esc="country.code"/>
                                                    </button>
                                                </t>
                                                <div class="o_dialer_country_no_results" t-if="filteredCountries.length === 0">
                                                    No countries found
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <input
                                        type="tel"
                                        t-att-value="state.phoneNumber"
                                        t-on-input="onInput"
                                        t-att-disabled="isCallActive or isIncoming"
                                        t-att-readonly="isCallActive or isIncoming"
                                        class="o_dialer_phone_input"
                                        placeholder="Enter phone number"/>
                                    <button
                                        type="button"
                                        class="o_dialer_phone_erase"
                                        t-att-disabled="!state.phoneNumber or isCallActive or isIncoming"
                                        t-on-click="backspace"
                                        title="Erase last digit"
                                        aria-label="Erase last digit">
                                        <i class="fa fa-long-arrow-left"/>
                                    </button>
                                </div>
                            </div>

                            <div class="o_dialer_keypad" t-att-class="{ 'o_dialer_keypad--dtmf': isCallActive or isIncoming }">
                                <t t-foreach="dialPadKeys"
                                   t-as="key"
                                   t-key="key.digit">
                                    <button
                                        type="button"
                                        class="o_dialer_key"
                                        t-on-click="() => this.appendDigit(key.digit)">
                                        <span class="o_dialer_key_digit" t-esc="key.digit"/>
                                        <span class="o_dialer_key_letters" t-esc="key.letters"/>
                                    </button>
                                </t>
                            </div>

                            <div class="o_dialer_dtmf_feedback" t-if="(isCallActive or isIncoming) and state.dtmfBuffer">
                                <span class="o_dialer_dtmf_label">DTMF</span>
                                <span class="o_dialer_dtmf_digits" t-esc="state.dtmfBuffer"/>
                            </div>

                            <div class="o_dialer_actions" t-att-class="{ 'o_dialer_actions--in-call': isCallActive or isIncoming }">
                                <t t-if="isIncoming">
                                    <div class="o_dialer_incoming_actions" style="margin-bottom: 0;">
                                        <button
                                            type="button"
                                            class="o_dialer_incoming_btn o_dialer_incoming_btn--accept"
                                            t-on-click="onAcceptCall"
                                            title="Accept Call"
                                            aria-label="Accept Call">
                                            <i class="fa fa-phone"/>
                                            <span>Accept</span>
                                        </button>
                                        <button
                                            type="button"
                                            class="o_dialer_incoming_btn o_dialer_incoming_btn--decline"
                                            t-on-click="onRejectCall"
                                            title="Decline Call"
                                            aria-label="Decline Call">
                                            <i class="fa fa-phone"/>
                                            <span>Decline</span>
                                        </button>
                                    </div>
                                </t>
                                <t t-elif="isCallActive">
                                    <button
                                        type="button"
                                        class="o_dialer_action_btn o_dialer_action_btn--mute"
                                        t-att-class="{ 'o_dialer_action_btn--mute-active': state.isMuted }"
                                        t-on-click="onToggleMute"
                                        t-att-title="state.isMuted ? 'Unmute' : 'Mute'"
                                        t-att-aria-label="state.isMuted ? 'Unmute' : 'Mute'">
                                        <i t-att-class="state.isMuted ? 'fa fa-microphone-slash' : 'fa fa-microphone'"/>
                                        <span t-esc="state.isMuted ? 'Unmute' : 'Mute'"/>
                                    </button>
                                    <button
                                        type="button"
                                        class="o_dialer_action_btn o_dialer_action_btn--hangup"
                                        t-on-click="onHangUp"
                                        title="Hang Up"
                                        aria-label="Hang Up">
                                        <i class="fa fa-phone"/>
                                        <span>Hang Up</span>
                                    </button>
                                </t>
                                <t t-else="">
                                    <button
                                        type="button"
                                        class="o_dialer_action_btn o_dialer_action_btn--call"
                                        t-att-disabled="!canCall"
                                        t-on-click="onCall"
                                        title="Call"
                                        aria-label="Call">
                                        <i class="fa fa-phone"/>
                                    </button>
                                    <button
                                        type="button"
                                        class="o_dialer_action_btn o_dialer_action_btn--redial"
                                        t-att-disabled="!canRedial"
                                        t-on-click="onRedial"
                                        title="Redial"
                                        aria-label="Redial">
                                        <i class="fa fa-repeat"/>
                                    </button>
                                </t>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- Auto Dialer tab — Queue Runner -->
                <t t-elif="state.activeTab === 'auto_dialer'">
                    <AutoDialerRunner/>
                </t>

                <!-- Contacts tab (opens Contacts menu) -->
                <t t-elif="state.activeTab === 'contacts'">
                    <div class="o_dialer_tab_panel">
                        <div class="o_dialer_tab_hero">
                            <i class="fa fa-address-book o_dialer_tab_hero_icon"/>
                            <h3 class="o_dialer_tab_title">Contacts</h3>
                            <p class="o_dialer_tab_copy">
                                Open the Contacts list to call anyone with a phone number.
                            </p>
                        </div>
                        <div class="o_dialer_empty_card">
                            <i class="fa fa-external-link"/>
                            <span>Opening Contacts…</span>
                            <p>Click Call on any contact to dial with Power Dialer.</p>
                        </div>
                        <div class="o_dialer_tab_actions">
                            <button type="button"
                                    class="o_dialer_action_btn o_dialer_action_btn--call"
                                    t-on-click.stop="openContacts">
                                <i class="fa fa-address-book"/>
                                <span>Open Contacts</span>
                            </button>
                        </div>
                    </div>
                </t>

                <!-- Help tab -->
                <t t-elif="state.activeTab === 'help'">
                    <div class="o_dialer_tab_panel o_dialer_help">
                        <div class="o_dialer_tab_hero">
                            <i class="fa fa-life-ring o_dialer_tab_hero_icon"/>
                            <h3 class="o_dialer_tab_title">Help</h3>
                            <p class="o_dialer_tab_copy">
                                Quick tips to get calling with Twilio Call Auto Dialer.
                            </p>
                        </div>
                        <div class="o_dialer_help_list">
                            <div class="o_dialer_help_item">
                                <span class="o_dialer_help_step">$</span>
                                <div>
                                    <strong>Free with fair usage</strong>
                                    <p>Free to install with a monthly fair-usage allowance. Higher volume via In-App Purchases. Voice minutes billed by Twilio on your account.</p>
                                </div>
                            </div>
                            <div class="o_dialer_help_item">
                                <span class="o_dialer_help_step">1</span>
                                <div>
                                    <strong>Configure Twilio</strong>
                                    <p>Set Account SID, Auth Token, API Key/Secret, Application SID, and your Twilio Phone Number in Configuration → Account Credentials.</p>
                                </div>
                            </div>
                            <div class="o_dialer_help_item">
                                <span class="o_dialer_help_step">2</span>
                                <div>
                                    <strong>Dial or click-to-call</strong>
                                    <p>Use the keypad or click <strong>Call</strong> on any Contact record.</p>
                                </div>
                            </div>
                            <div class="o_dialer_help_item">
                                <span class="o_dialer_help_step">3</span>
                                <div>
                                    <strong>Call Logs &amp; AI</strong>
                                    <p>Call history logs automatically under <strong>Call Logs</strong>. Enable AI Transcription and Summary in Configuration → AI Settings.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- About Us tab -->
                <t t-elif="state.activeTab === 'about'">
                    <div class="o_dialer_tab_panel o_dialer_about">
                        <div class="o_dialer_tab_hero">
                            <i class="fa fa-info-circle o_dialer_tab_hero_icon"/>
                            <h3 class="o_dialer_tab_title">About Twilio Call Auto Dialer</h3>
                            <p class="o_dialer_tab_copy">
                                Powered by Solutions Master &amp; MyBroadcast.
                            </p>
                        </div>
                        <div class="o_dialer_about_card">
                            <p><strong>Version:</strong> 18.0.1.2.63</p>
                            <p>Built for Odoo 18 — Cloud VoIP softphone, click-to-call, auto dialer, call recording, AI transcription &amp; summaries.</p>
                            <div class="o_dialer_about_links">
                                <a href="https://extension.mybroadcast.online" target="_blank" class="o_dialer_about_link">
                                    <i class="fa fa-globe"/> Website
                                </a>
                                <a href="mailto:developer.lifetips@gmail.com" class="o_dialer_about_link">
                                    <i class="fa fa-envelope"/> Support
                                </a>
                            </div>
                        </div>
                    </div>
                </t>

            </div>

            <!-- Footer / Navigation -->
            <div class="o_dialer_footer">
                <button
                    type="button"
                    class="o_dialer_nav_btn"
                    t-att-class="{ 'o_dialer_nav_btn--active': state.activeTab === 'dialpad' }"
                    t-on-click="() => this.setActiveTab('dialpad')">
                    <i class="fa fa-phone"/>
                    <span>Dial Pad</span>
                </button>
                <button
                    type="button"
                    class="o_dialer_nav_btn"
                    t-att-class="{ 'o_dialer_nav_btn--active': state.activeTab === 'auto_dialer' }"
                    t-on-click="() => this.setActiveTab('auto_dialer')">
                    <i class="fa fa-android"/>
                    <span>Auto Dialer</span>
                </button>
                <button
                    type="button"
                    class="o_dialer_nav_btn"
                    t-att-class="{ 'o_dialer_nav_btn--active': state.activeTab === 'contacts' }"
                    t-on-click="() => this.setActiveTab('contacts')">
                    <i class="fa fa-user"/>
                    <span>Contacts</span>
                </button>
                <button
                    type="button"
                    class="o_dialer_nav_btn"
                    t-att-class="{ 'o_dialer_nav_btn--active': state.activeTab === 'help' }"
                    t-on-click="() => this.setActiveTab('help')">
                    <i class="fa fa-question-circle-o"/>
                    <span>Help</span>
                </button>
                <button
                    type="button"
                    class="o_dialer_nav_btn"
                    t-att-class="{ 'o_dialer_nav_btn--active': state.activeTab === 'about' }"
                    t-on-click="() => this.setActiveTab('about')">
                    <i class="fa fa-envelope-o"/>
                    <span>Contact Us</span>
                </button>
            </div>

        </div>
    </t>

    <!-- AutoDialerRunner Template -->

    <t t-name="twilio_dialer.AutoDialerRunner">
        <div class="o_dialer_qrunner">

            <!-- Queue Selector Row -->
            <div class="o_dialer_section o_dialer_qrunner_selector_row">
                <label class="o_dialer_label">Queue</label>
                <div class="o_dialer_qrunner_selector_wrap">
                    <select class="o_dialer_qrunner_select"
                            t-on-change="(ev) => this.onSelectQueue(ev.target.value)"
                            t-att-disabled="state.actionPending || isRunning">
                        <option value="">— Select a queue —</option>
                        <t t-foreach="state.queues" t-as="q" t-key="q.id">
                            <option t-att-value="q.id"
                                    t-att-selected="state.activeQueue and state.activeQueue.id === q.id">
                                <t t-esc="q.name"/>
                            </option>
                        </t>
                    </select>
                    <button type="button"
                            class="o_dialer_icon_btn"
                            title="Refresh queue list"
                            t-att-disabled="state.loadingQueues"
                            t-on-click.stop="onRefresh">
                        <i t-att-class="state.loadingQueues ? 'fa fa-spinner fa-spin' : 'fa fa-refresh'"/>
                    </button>
                </div>
            </div>

            <!-- No Queue Selected -->
            <t t-if="!state.activeQueue">
                <div class="o_dialer_empty_card o_dialer_qrunner_empty">
                    <i class="fa fa-bolt"/>
                    <span>No queue selected</span>
                    <p>Choose a dialing queue above, then click Start.</p>
                </div>
            </t>

            <t t-else="">
                <!-- Queue Header: name + status badge -->
                <div class="o_dialer_qrunner_header">
                    <span class="o_dialer_qrunner_name" t-esc="state.activeQueue.name"/>
                    <span class="o_dialer_qrunner_badge" t-att-class="statusBadgeClass">
                        <t t-if="isRunning"><i class="fa fa-circle"/> </t>
                        <t t-esc="statusLabel"/>
                    </span>
                </div>

                <!-- Progress Bar -->
                <div class="o_dialer_qrunner_progress_wrap">
                    <div class="o_dialer_qrunner_progress_bar">
                        <div class="o_dialer_qrunner_progress_fill"
                             t-att-style="'width:' + state.stats.progress + '%'"/>
                    </div>
                    <span class="o_dialer_qrunner_progress_label">
                        <t t-esc="state.stats.progress"/>%
                    </span>
                </div>

                <!-- Stats Grid -->
                <div class="o_dialer_qrunner_stats">
                    <div class="o_dialer_qrunner_stat">
                        <span class="o_dialer_qrunner_stat_value" t-esc="state.stats.total"/>
                        <span class="o_dialer_qrunner_stat_label">Total</span>
                    </div>
                    <div class="o_dialer_qrunner_stat o_dialer_qrunner_stat--pending">
                        <span class="o_dialer_qrunner_stat_value" t-esc="state.stats.pending"/>
                        <span class="o_dialer_qrunner_stat_label">Pending</span>
                    </div>
                    <div class="o_dialer_qrunner_stat o_dialer_qrunner_stat--done">
                        <span class="o_dialer_qrunner_stat_value" t-esc="state.stats.completed"/>
                        <span class="o_dialer_qrunner_stat_label">Done</span>
                    </div>
                    <div class="o_dialer_qrunner_stat o_dialer_qrunner_stat--fail">
                        <span class="o_dialer_qrunner_stat_value" t-esc="state.stats.failed"/>
                        <span class="o_dialer_qrunner_stat_label">Failed</span>
                    </div>
                    <div class="o_dialer_qrunner_stat o_dialer_qrunner_stat--skip">
                        <span class="o_dialer_qrunner_stat_value" t-esc="state.stats.skipped"/>
                        <span class="o_dialer_qrunner_stat_label">Skipped</span>
                    </div>
                </div>

                <!-- Queue Controls -->
                <div class="o_dialer_qrunner_controls">
                    <t t-if="isDraft">
                        <button type="button"
                                class="o_dialer_action_btn o_dialer_action_btn--call o_dialer_qrunner_ctrl_btn"
                                t-att-disabled="state.actionPending"
                                t-on-click="onStart">
                            <i class="fa fa-play"/>
                            <span>Start</span>
                        </button>
                    </t>
                    <t t-elif="isRunning">
                        <button type="button"
                                class="o_dialer_action_btn o_dialer_action_btn--mute o_dialer_qrunner_ctrl_btn"
                                t-att-disabled="state.actionPending"
                                t-on-click="onPause">
                            <i class="fa fa-pause"/>
                            <span>Pause</span>
                        </button>
                        <button type="button"
                                class="o_dialer_action_btn o_dialer_action_btn--hangup o_dialer_qrunner_ctrl_btn"
                                t-att-disabled="state.actionPending"
                                t-on-click="onStop">
                            <i class="fa fa-stop"/>
                            <span>Stop</span>
                        </button>
                    </t>
                    <t t-elif="isPaused">
                        <button type="button"
                                class="o_dialer_action_btn o_dialer_action_btn--call o_dialer_qrunner_ctrl_btn"
                                t-att-disabled="state.actionPending"
                                t-on-click="onResume">
                            <i class="fa fa-play"/>
                            <span>Resume</span>
                        </button>
                        <button type="button"
                                class="o_dialer_action_btn o_dialer_action_btn--hangup o_dialer_qrunner_ctrl_btn"
                                t-att-disabled="state.actionPending"
                                t-on-click="onStop">
                            <i class="fa fa-stop"/>
                            <span>Stop</span>
                        </button>
                    </t>
                    <t t-elif="isCompleted">
                        <div class="o_dialer_qrunner_done_msg">
                            <i class="fa fa-check-circle"/>
                            <span>Queue finished</span>
                        </div>
                    </t>
                </div>

                <!-- Current Contact Card -->
                <t t-if="state.currentLine and (isRunning or isPaused)">
                    <div class="o_dialer_qrunner_contact_card">
                        <div class="o_dialer_qrunner_contact_head">
                            <div class="o_dialer_qrunner_avatar">
                                <i class="fa fa-user"/>
                            </div>
                            <div class="o_dialer_qrunner_contact_info">
                                <span class="o_dialer_qrunner_contact_name"
                                      t-esc="state.currentLine.partner_name || state.currentLine.phone"/>
                                <span class="o_dialer_qrunner_contact_phone"
                                      t-esc="state.currentLine.phone"/>
                            </div>
                            <span class="o_dialer_qrunner_line_badge"
                                  t-att-class="lineStatusBadgeClass"
                                  t-esc="lineStatusLabel"/>
                        </div>
                        <div class="o_dialer_qrunner_contact_meta">
                            <span class="o_dialer_qrunner_meta_item">
                                <i class="fa fa-list-ol"/>
                                <t t-esc="state.currentLine.queue_position || '—'"/>
                            </span>
                            <span class="o_dialer_qrunner_meta_item">
                                <i class="fa fa-repeat"/>
                                Attempt <t t-esc="(state.currentLine.attempt_count || 0) + 1"/>
                            </span>
                        </div>
                        <t t-if="state.currentLine.notes">
                            <div class="o_dialer_qrunner_notes">
                                <i class="fa fa-sticky-note-o"/>
                                <span t-esc="state.currentLine.notes"/>
                            </div>
                        </t>
                        <div class="o_dialer_qrunner_call_hint">
                            <i class="fa fa-arrow-up"/>
                            <span>Switch to Dialpad and click Call</span>
                        </div>
                    </div>

                    <!-- Navigation row -->
                    <div class="o_dialer_qrunner_nav">
                        <button type="button"
                                class="o_dialer_icon_btn o_dialer_qrunner_nav_btn"
                                title="Previous contact"
                                t-att-disabled="state.actionPending"
                                t-on-click="onPrev">
                            <i class="fa fa-chevron-left"/>
                            <span>Prev</span>
                        </button>
                        <button type="button"
                                class="o_dialer_icon_btn o_dialer_qrunner_nav_btn o_dialer_qrunner_nav_btn--skip"
                                title="Skip this contact"
                                t-att-disabled="state.actionPending"
                                t-on-click="onSkip">
                            <i class="fa fa-forward"/>
                            <span>Skip</span>
                        </button>
                        <button type="button"
                                class="o_dialer_icon_btn o_dialer_qrunner_nav_btn"
                                title="Next contact"
                                t-att-disabled="state.actionPending"
                                t-on-click="onNext">
                            <i class="fa fa-chevron-right"/>
                            <span>Next</span>
                        </button>
                    </div>
                </t>

                <!-- No contact loaded yet (draft queue) -->
                <t t-elif="isDraft and state.stats.total > 0">
                    <div class="o_dialer_qrunner_hint">
                        <i class="fa fa-info-circle"/>
                        <span><t t-esc="state.stats.total"/> contact(s) ready. Click Start to begin.</span>
                    </div>
                </t>

                <t t-elif="isDraft and state.stats.total === 0">
                    <div class="o_dialer_empty_card o_dialer_qrunner_empty">
                        <i class="fa fa-users"/>
                        <span>No contacts in this queue</span>
                        <p>Go to Contacts and use "Add to Auto Dialer" to populate it.</p>
                    </div>
                </t>

            </t>
        </div>
    </t>

</templates>
