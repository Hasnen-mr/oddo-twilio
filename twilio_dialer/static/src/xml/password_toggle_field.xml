<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="twilio_dialer.PasswordToggleField">
        <t t-if="props.readonly">
            <div class="o_twilio_password_toggle o_twilio_password_toggle--readonly">
                <span t-esc="formattedValue"/>
                <button type="button"
                        class="o_twilio_password_eye btn btn-link"
                        t-att-title="eyeTitle"
                        t-att-aria-label="eyeTitle"
                        t-on-click="toggleVisibility"
                        t-if="props.record.data[props.name]">
                    <i class="fa" t-att-class="eyeIcon"/>
                </button>
            </div>
        </t>
        <t t-else="">
            <div class="o_twilio_password_toggle">
                <input
                    class="o_input"
                    t-att-class="{
                        'o_field_translate': isTranslatable,
                        'o_field_placeholder': hasDynamicPlaceholder
                    }"
                    t-att-id="props.id"
                    t-att-type="inputType"
                    t-att-autocomplete="props.autocomplete or 'new-password'"
                    t-att-maxlength="maxLength > 0 and maxLength"
                    t-att-placeholder="placeholder"
                    t-on-blur="onBlur"
                    t-ref="input"
                />
                <button type="button"
                        class="o_twilio_password_eye btn btn-link"
                        t-att-title="eyeTitle"
                        t-att-aria-label="eyeTitle"
                        tabindex="-1"
                        t-on-click="toggleVisibility">
                    <i class="fa" t-att-class="eyeIcon"/>
                </button>
            </div>
        </t>
    </t>

</templates>
