<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- WhatsApp Web Style SMS Workspace Client Action -->
    <t t-name="twilio_dialer.TwilioSmsWorkspaceClientAction">
        <div class="o_twilio_wa_workspace">

            <!-- LEFT SIDEBAR: WhatsApp Web Conversation List -->
            <aside class="o_twilio_wa_sidebar">

                                                <!-- Sidebar Top App Bar: WhatsApp Web Clean Bold Hierarchy -->
                <header class="o_twilio_wa_sidebar_header">
                    <h1 class="o_twilio_wa_sidebar_title">Chats</h1>
                    <div class="o_twilio_wa_header_actions">
                        <button type="button" class="o_twilio_wa_icon_btn" title="New chat" t-on-click="() => this.toggleNewChat()">
                            <i class="fa fa-pencil-square-o"/>
                        </button>
                        <div class="dropdown d-inline-block">
                            <button type="button" class="o_twilio_wa_icon_btn" data-bs-toggle="dropdown" title="Menu">
                                <i class="fa fa-ellipsis-v"/>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-1" style="font-size: 13px;">
                                <li>
                                    <a class="dropdown-item py-2" href="#" t-on-click.prevent="() => this.openSmsTemplates()">
                                        <i class="fa fa-file-text-o text-primary me-2"/> SMS Templates
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="#" t-on-click.prevent="() => this.openQuickReplies()">
                                        <i class="fa fa-bolt text-warning me-2"/> Quick Replies
                                    </a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider my-1"/>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="#" t-on-click.prevent="() => this.loadWorkspaceData()">
                                        <i class="fa fa-refresh text-success me-2"/> Refresh Chats
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- New Number Input Bar (Collapsible) -->
                <t t-if="this.state.showNewChatInput">
                    <div class="o_twilio_wa_new_chat_bar p-2 bg-light border-bottom">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="fa fa-phone text-muted"/></span>
                            <input type="text"
                                   class="form-control border-start-0 shadow-none"
                                   placeholder="Enter phone number (+1...)"
                                   t-model="this.state.newNumberInput"
                                   t-on-keydown="(ev) => ev.key === 'Enter' and this.startNewChatWithNumber()"/>
                            <button type="button" class="btn btn-primary btn-sm px-3" t-on-click="() => this.startNewChatWithNumber()">
                                Chat
                            </button>
                        </div>
                    </div>
                </t>

                <!-- Search Input Row -->
                <div class="o_twilio_wa_search_row">
                    <div class="o_twilio_wa_search_box">
                        <i class="fa fa-search o_twilio_wa_search_icon"/>
                        <input type="text"
                               class="o_twilio_wa_search_input"
                               placeholder="Search or start new chat"
                               t-model="this.state.searchQuery"/>
                        <t t-if="this.state.searchQuery">
                            <button type="button" class="o_twilio_wa_search_clear" t-on-click="() => this.state.searchQuery = ''">
                                <i class="fa fa-times"/>
                            </button>
                        </t>
                    </div>
                </div>

                <!-- Filter Chips Row (All, Unread, Logs, Drafts) -->
                <nav class="o_twilio_wa_filter_row" aria-label="Conversation Filters">
                    <button type="button"
                            t-att-class="this.state.filterTab === 'all' ? 'o_twilio_wa_filter_chip active' : 'o_twilio_wa_filter_chip'"
                            t-on-click="() => this.setFilterTab('all')">
                        All <span class="o_twilio_wa_chip_badge" t-esc="this.state.conversations.length"/>
                    </button>
                    <button type="button"
                            t-att-class="this.state.filterTab === 'unread' ? 'o_twilio_wa_filter_chip active' : 'o_twilio_wa_filter_chip'"
                            t-on-click="() => this.setFilterTab('unread')">
                        Unread
                    </button>
                    <button type="button"
                            t-att-class="this.state.filterTab === 'logs' ? 'o_twilio_wa_filter_chip active' : 'o_twilio_wa_filter_chip'"
                            t-on-click="() => this.setFilterTab('logs')">
                        Logs <span class="o_twilio_wa_chip_badge" t-esc="(this.state.counts and this.state.counts.logs) or 0"/>
                    </button>
                    <button type="button"
                            t-att-class="this.state.filterTab === 'drafts' ? 'o_twilio_wa_filter_chip active' : 'o_twilio_wa_filter_chip'"
                            t-on-click="() => this.setFilterTab('drafts')">
                        Drafts <span class="o_twilio_wa_chip_badge" t-esc="this.state.drafts.length"/>
                    </button>
                </nav>

                <!-- Conversation Stream List -->
                <div class="o_twilio_wa_conversation_list">
                    <t t-if="this.state.loading">
                        <div class="o_twilio_wa_loading">
                            <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"/>
                            <span>Loading conversations...</span>
                        </div>
                    </t>
                    <t t-elif="filteredConversations.length === 0">
                        <div class="o_twilio_wa_empty_list">
                            <i class="fa fa-comments-o fa-2x mb-2 text-muted opacity-50"/>
                            <p class="mb-0 text-muted small">No conversations found.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <t t-foreach="filteredConversations || []" t-as="conv" t-key="conv.phone">
                            <div t-att-class="this.state.selectedContact and this.state.selectedContact.phone === conv.phone and this.state.filterTab !== 'logs' ? 'o_twilio_wa_item active' : 'o_twilio_wa_item'"
                                 t-on-click="() => this.selectConversation(conv)">

                                <!-- Contact Avatar with dynamic color -->
                                <div class="o_twilio_wa_avatar" t-att-style="'background-color: ' + this.getAvatarColor(conv.name)">
                                    <span t-esc="this.getInitials(conv.name)"/>
                                </div>

                                <!-- Contact Details & Snippet -->
                                <div class="o_twilio_wa_item_body">
                                    <div class="o_twilio_wa_item_header">
                                        <span class="o_twilio_wa_item_name text-truncate" t-esc="conv.name"/>
                                        <span class="o_twilio_wa_item_time text-nowrap" t-esc="this.formatDate(conv.last_date)"/>
                                    </div>
                                    <div class="o_twilio_wa_item_preview_row">
                                        <div class="o_twilio_wa_item_snippet text-truncate">
                                            <t t-if="conv.last_direction === 'incoming' or conv.last_direction === 'inbound'">
                                                <i class="fa fa-arrow-down text-info me-1" title="Incoming"/>
                                            </t>
                                            <t t-elif="conv.last_direction === 'outgoing' or conv.last_direction === 'outbound'">
                                                <i class="fa fa-check text-primary me-1" title="Outgoing"/>
                                            </t>
                                            <t t-if="conv.last_message">
                                                <t t-esc="conv.last_message"/>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted fst-italic" t-esc="conv.phone"/>
                                            </t>
                                        </div>

                                        <div class="o_twilio_wa_item_meta">
                                            <t t-if="conv.unread">
                                                <span class="o_twilio_wa_unread_badge">1</span>
                                            </t>
                                            <!-- Quick call on hover -->
                                            <button type="button"
                                                    class="o_twilio_wa_quick_call_btn"
                                                    title="Call Contact"
                                                    t-on-click="(ev) => this.makeCall(conv.phone, conv.partner_id, conv.name, ev)">
                                                <i class="fa fa-phone"/>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>

            </aside>

            <!-- RIGHT MAIN PANEL: Active Chat or Full Logs Table -->
            <main class="o_twilio_wa_main">

                <!-- Tab 1: Live Chat Workspace (Default) -->
                <t t-if="this.state.filterTab !== 'logs'">
                    <t t-if="this.state.selectedContact">
                        <div class="o_twilio_wa_chat_container">
                            <TwilioSmsPopup isEmbedded="true"
                                            phone="this.state.selectedContact.phone"
                                            partnerId="this.state.selectedContact.partner_id"
                                            partnerName="this.state.selectedContact.name"
                                            onClose="() => this.onChatClosed()"/>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="o_twilio_wa_hero_empty">
                            <div class="o_twilio_wa_hero_icon">
                                <i class="fa fa-comments-o"/>
                            </div>
                            <h3 class="fw-bold text-slate-800 mb-2">Twilio SMS Hub</h3>
                            <p class="text-muted text-center max-w-md mb-4">
                                Send and receive instant two-way SMS messages. Select a contact from the left sidebar or start a new chat.
                            </p>
                            <div class="d-flex gap-3">
                                <button type="button" class="btn btn-primary px-4 py-2" t-on-click="() => this.toggleNewChat()">
                                    <i class="fa fa-paper-plane me-2"/>New Message
                                </button>
                                <button type="button" class="btn btn-outline-secondary px-4 py-2" t-on-click="() => this.setFilterTab('logs')">
                                    <i class="fa fa-history me-2"/>View Logs
                                </button>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- Tab 2: Logs Explorer Full Table View -->
                <t t-else="">
                    <div class="o_twilio_wa_logs_view p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                            <div>
                                <h4 class="fw-bold m-0 text-slate-800">
                                    <i class="fa fa-history text-success me-2"/>SMS Message Logs
                                </h4>
                                <small class="text-muted">Live audit trail of all sent and received SMS messages.</small>
                            </div>
                            <span class="badge bg-success px-3 py-2" t-esc="((this.state.counts and this.state.counts.logs) or 0) + ' Messages'"/>
                        </div>

                        <div class="card border shadow-sm">
                            <div class="table-responsive" style="max-height: calc(100vh - 220px); overflow-y: auto;">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light text-muted small text-uppercase sticky-top">
                                        <tr>
                                            <th class="ps-3">Date</th>
                                            <th>Contact</th>
                                            <th>Phone Number</th>
                                            <th>Direction</th>
                                            <th>Status</th>
                                            <th class="pe-3">Message</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        <t t-foreach="this.state.recentLogs || []" t-as="log" t-key="log.id">
                                            <tr class="cursor-pointer" t-on-click="() => this.selectConversation({ phone: log.to_number || log.from_number, partner_id: log.partner_id ? log.partner_id[0] : false, name: log.partner_id ? log.partner_id[1] : log.phone_number })">
                                                <td class="ps-3 text-nowrap text-muted" t-esc="log.create_date || ''"/>
                                                <td class="fw-semibold text-slate-800">
                                                    <t t-if="log.partner_id">
                                                        <i class="fa fa-user text-muted me-1"/><t t-esc="log.partner_id[1]"/>
                                                    </t>
                                                    <t t-else="">—</t>
                                                </td>
                                                <td class="fw-medium text-slate-700" t-esc="log.to_number || log.from_number"/>
                                                <td>
                                                    <t t-if="log.direction === 'inbound' or log.direction === 'incoming'">
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1 rounded-pill">
                                                            <i class="fa fa-arrow-down me-1"/>Incoming
                                                        </span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                                                            <i class="fa fa-arrow-up me-1"/>Outgoing
                                                        </span>
                                                    </t>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border px-2 py-1 rounded-pill text-capitalize" t-esc="log.status || 'sent'"/>
                                                </td>
                                                <td class="pe-3 text-break text-muted">
                                                    <t t-esc="log.body"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>

            </main>

        </div>
    </t>

</templates>
