<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="twilio_dialer.TwilioSmsWorkspaceClientAction">
        <div class="o_twilio_sms_workspace container-fluid p-4">

            <!-- Workspace Header Banner -->
            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                <div>
                    <h2 class="fw-bold mb-1 text-slate-800">
                        <i class="fa fa-comments text-primary me-2"/>SMS Workspace
                    </h2>
                    <p class="text-muted mb-0">
                        Centralized management hub for Twilio SMS messaging, contact conversations, templates, and quick replies.
                    </p>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm" t-on-click="loadWorkspaceData">
                    <i class="fa fa-refresh me-1"/> Refresh Hub
                </button>
            </div>

            <t t-if="state.loading">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status"/>
                    <div class="text-muted fw-medium">Loading SMS Workspace Dashboard...</div>
                </div>
            </t>

            <t t-else="">
                <!-- Section 1: Management Cards Grid (4 Cards: 1. Message, 2. SMS Logs, 3. SMS Templates, 4. Quick Replies) -->
                <div class="row g-4 mb-5">

                    <!-- Card 1: Message (Takes to Contact List / WhatsApp-style messaging) -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm o_twilio_workspace_card" t-on-click="openMessagesList">
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="o_twilio_card_icon bg-primary-subtle text-primary">
                                            <i class="fa fa-paper-plane fa-lg"/>
                                        </div>
                                        <span class="badge bg-primary rounded-pill px-3 py-2" t-esc="state.counts.contacts + ' Contacts'"/>
                                    </div>
                                    <h5 class="fw-bold text-slate-800 mb-2">1. Message</h5>
                                    <p class="small text-muted mb-3">
                                        Select any contact from your list to open live SMS chat &amp; message them directly.
                                    </p>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary w-100 mt-2">
                                    Start Messaging <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Card 2: SMS Logs -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm o_twilio_workspace_card" t-on-click="openSmsLogs">
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="o_twilio_card_icon bg-success-subtle text-success">
                                            <i class="fa fa-history fa-lg"/>
                                        </div>
                                        <span class="badge bg-success rounded-pill px-3 py-2" t-esc="state.counts.logs + ' Logs'"/>
                                    </div>
                                    <h5 class="fw-bold text-slate-800 mb-2">2. SMS Logs</h5>
                                    <p class="small text-muted mb-3">
                                        View live incoming and outgoing Twilio SMS message history.
                                    </p>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-success w-100 mt-2">
                                    Open Logs <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Card 3: SMS Templates -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm o_twilio_workspace_card" t-on-click="openSmsTemplates">
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="o_twilio_card_icon bg-info-subtle text-info">
                                            <i class="fa fa-file-text-o fa-lg"/>
                                        </div>
                                        <span class="badge bg-info rounded-pill px-3 py-2 text-white" t-esc="state.counts.templates + ' Templates'"/>
                                    </div>
                                    <h5 class="fw-bold text-slate-800 mb-2">3. SMS Templates</h5>
                                    <p class="small text-muted mb-3">
                                        Manage reusable text templates with dynamic placeholders.
                                    </p>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-info w-100 mt-2">
                                    Open Templates <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Card 4: Quick Replies -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm o_twilio_workspace_card" t-on-click="openQuickReplies">
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="o_twilio_card_icon bg-warning-subtle text-warning">
                                            <i class="fa fa-bolt fa-lg"/>
                                        </div>
                                        <span class="badge bg-warning rounded-pill px-3 py-2 text-dark" t-esc="state.counts.quick_replies + ' Quick Replies'"/>
                                    </div>
                                    <h5 class="fw-bold text-slate-800 mb-2">4. Quick Replies</h5>
                                    <p class="small text-muted mb-3">
                                        Configure quick response pills for one-click insertion.
                                    </p>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-warning w-100 mt-2">
                                    Manage Quick Replies <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Section 2: Active Unsent Draft Messages Section -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                        <h4 class="fw-bold m-0 text-slate-800">
                            <i class="fa fa-pencil-square-o text-warning me-2"/>Active Unsent Drafts
                        </h4>
                        <span class="badge bg-warning text-dark px-3 py-2" t-esc="state.drafts.length + ' Drafts'"/>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <t t-if="state.drafts.length === 0">
                            <div class="text-center py-4 text-muted">
                                <i class="fa fa-check-circle-o fa-2x mb-2 text-success opacity-75"/>
                                <p class="mb-0">No active unsent drafts. All messages are cleared!</p>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="row g-3">
                                <t t-foreach="state.drafts" t-as="draft" t-key="draft.phone">
                                    <div class="col-12 col-md-6 col-lg-4">
                                        <div class="card h-100 border o_twilio_draft_card p-3" t-on-click="() => this.openDraft(draft)">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <div class="fw-bold text-primary">
                                                    <i class="fa fa-phone me-1"/> <t t-esc="draft.phone"/>
                                                </div>
                                                <small class="text-muted" t-esc="draft.timestampStr"/>
                                            </div>
                                            <div class="p-2 bg-light rounded text-slate-700 small mb-2 text-break">
                                                " <t t-esc="draft.preview"/> "
                                            </div>
                                            <div class="d-flex align-items-center justify-content-between mt-auto">
                                                <span class="text-primary small fw-semibold">Click to resume ➔</span>
                                                <button type="button" class="btn btn-link btn-sm text-danger p-0 text-decoration-none" t-on-click="(ev) => this.clearDraft(draft, ev)" title="Discard Draft">
                                                    <i class="fa fa-trash me-1"/> Discard
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>

            </t>

        </div>
    </t>

</templates>
