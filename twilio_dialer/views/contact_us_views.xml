<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_twilio_contact_us_form" model="ir.ui.view">
        <field name="name">twilio.contact.us.form</field>
        <field name="model">twilio.contact.us</field>
        <field name="arch" type="xml">
            <form string="About Us" create="0" edit="0" delete="0">
                <header>
                    <button name="%(action_twilio_open_phone)d"
                            type="action"
                            string="Open Phone"
                            icon="fa-phone"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="o_twilio_contact_hero">
                        <div class="o_twilio_contact_hero_icon">
                            <i class="fa fa-info-circle" title="About us"/>
                        </div>
                        <div>
                            <h1>About Us</h1>
                            <p>
                                Learn about Twilio Call Auto Dialer and reach our team for
                                setup help, product support, or a personalized walkthrough.
                            </p>
                        </div>
                    </div>

                    <div class="o_twilio_contact_section_title">
                        What we offer
                    </div>

                    <div class="o_twilio_help_page_list">
                        <div class="o_twilio_help_page_item">
                            <span class="o_twilio_help_page_step">
                                <i class="fa fa-phone" title="Calling"/>
                            </span>
                            <div>
                                <strong>Twilio calling in Odoo</strong>
                                <p>Browser softphone, Auto Dialer campaigns, call logs, and optional AI summaries.</p>
                            </div>
                        </div>
                        <div class="o_twilio_help_page_item">
                            <span class="o_twilio_help_page_step">
                                <i class="fa fa-shield" title="Data privacy"/>
                            </span>
                            <div>
                                <strong>Your account, your data</strong>
                                <p>Connects to your Twilio account. Credentials and call records stay in your Odoo database.</p>
                            </div>
                        </div>
                        <div class="o_twilio_help_page_item">
                            <span class="o_twilio_help_page_step">
                                <i class="fa fa-life-ring" title="Support"/>
                            </span>
                            <div>
                                <strong>Need help or contact?</strong>
                                <p>Open About Us → Help for setup tips and our email, WhatsApp, and booking links.</p>
                            </div>
                        </div>
                    </div>

                    <div class="o_twilio_contact_footer_note">
                        <i class="fa fa-shield" title="Privacy"/>
                        Your Twilio credentials and Odoo data remain in your own Odoo database.
                    </div>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_twilio_contact_us" model="ir.actions.server">
        <field name="name">About Us</field>
        <field name="model_id" ref="model_twilio_contact_us"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_contact_us()</field>
    </record>

</odoo>
