<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- SMS Logs List View -->
    <record id="view_twilio_sms_log_list" model="ir.ui.view">
        <field name="name">twilio.sms.log.list</field>
        <field name="model">twilio.sms.log</field>
        <field name="arch" type="xml">
            <list string="SMS Logs" create="0" edit="0" delete="0"
                  decoration-danger="status in ('failed','undelivered')"
                  decoration-warning="status in ('queued','sending')"
                  decoration-success="status in ('delivered','sent','received')">
                <field name="date_sent" string="Date"/>
                <field name="partner_id" string="Contact"/>
                <field name="phone_number" string="Phone Number"/>
                <field name="direction" widget="badge"
                       decoration-info="direction == 'inbound'"
                       decoration-primary="direction != 'inbound'"/>
                <field name="status" widget="badge"
                       decoration-success="status in ('delivered','sent','received')"
                       decoration-warning="status in ('queued','sending')"
                       decoration-danger="status in ('failed','undelivered')"/>
                <field name="body" string="Message Preview"/>
                <field name="sid" string="Message SID"/>
            </list>
        </field>
    </record>

    <!-- SMS Logs Search View -->
    <record id="view_twilio_sms_log_search" model="ir.ui.view">
        <field name="name">twilio.sms.log.search</field>
        <field name="model">twilio.sms.log</field>
        <field name="arch" type="xml">
            <search string="SMS Logs">
                <field name="partner_id" string="Contact"/>
                <field name="phone_number" string="Phone Number"/>
                <field name="body" string="Message"/>
                <field name="sid" string="Message SID"/>
                <filter string="Incoming" name="inbound" domain="[('direction', '=', 'inbound')]"/>
                <filter string="Outgoing" name="outbound" domain="[('direction', '=', 'outbound-api')]"/>
                <separator/>
                <filter string="Delivered" name="delivered" domain="[('status', '=', 'delivered')]"/>
                <filter string="Sent" name="sent" domain="[('status', '=', 'sent')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
<filter string="Contact" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Direction" name="group_direction" context="{'group_by': 'direction'}"/>
</search>
        </field>
    </record>

    <!-- Action for SMS Logs -->
    <record id="action_twilio_sms_log" model="ir.actions.act_window">
        <field name="name">SMS Logs</field>
        <field name="res_model">twilio.sms.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_twilio_sms_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No SMS logs found!
            </p>
            <p>
                SMS logs are fetched directly live from Twilio REST API.
            </p>
        </field>
    </record>

    <!-- Client Action for SMS Workspace Dashboard -->
    <record id="action_twilio_sms_workspace" model="ir.actions.client">
        <field name="name">SMS Workspace</field>
        <field name="tag">twilio_sms_workspace_action</field>
        <field name="target">current</field>
    </record>

</odoo>
