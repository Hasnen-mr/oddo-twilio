<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="twilio_dialer_pro.CredentialsHelpDialog">
        <Dialog size="'xl'" contentClass="'o_twilio_credentials_help_dialog_modal'">
            <div class="o_twilio_cred_help_wrapper">
                <!-- Glassmorphism Header -->
                <div class="o_twilio_cred_help_header">
                    <div class="o_twilio_cred_help_header_content">
                        <h4 class="o_twilio_cred_help_title">
                            <i class="fa fa-key me-2"/>How to get Account SID &amp; Auth Token
                        </h4>
                        <p class="o_twilio_cred_help_subtitle">Use these two values to sign in to the dialer. Switch tabs for Classic Console or New Twilio Account.</p>
                    </div>
                    <button type="button" class="o_twilio_cred_help_close" aria-label="Close" t-on-click="props.close">&#215;</button>
                </div>

                <!-- Glassmorphism Tab Switcher -->
                <div class="o_twilio_cred_help_tabs_container">
                    <div class="o_twilio_cred_help_tabs">
                        <button type="button"
                                class="o_twilio_cred_help_tab"
                                t-att-class="{ 'active': state.activeTab === 'classic' }"
                                t-on-click="() => this.setTab('classic')">
                            <i class="fa fa-dashboard me-1"/> Classic Console Twilio
                        </button>
                        <button type="button"
                                class="o_twilio_cred_help_tab"
                                t-att-class="{ 'active': state.activeTab === 'new' }"
                                t-on-click="() => this.setTab('new')">
                            <i class="fa fa-th-large me-1"/> New Twilio Account
                        </button>
                    </div>
                </div>

                <!-- Content Area (Only scrollable container) -->
                <div class="o_twilio_cred_help_content">
                    <!-- Tab 1: Classic Console Twilio -->
                    <div t-if="state.activeTab === 'classic'" class="o_twilio_cred_help_pane">
                        <div class="o_twilio_cred_instructions mb-3">
                            <div class="d-flex align-items-start mb-2">
                                <span class="badge o_twilio_step_badge me-2 mt-1">1</span>
                                <div>Log in to your <a href="https://console.twilio.com" target="_blank" rel="noopener noreferrer">Twilio Console</a> and navigate to <strong>Develop &#8594; Account Dashboard</strong> in the left sidebar.</div>
                            </div>
                            <div class="d-flex align-items-start">
                                <span class="badge o_twilio_step_badge me-2 mt-1">2</span>
                                <div>Under the <strong>Account Info</strong> section, locate your <strong>Account SID</strong> and <strong>Auth Token</strong> and click the copy icons.</div>
                            </div>
                        </div>
                        <div class="o_twilio_cred_image_container text-center">
                            <img src="/twilio_dialer_pro/static/src/img/twilio_classic_console_credentials.png"
                                 alt="Twilio Classic Console Credentials Guide"
                                 class="img-fluid rounded border shadow-sm o_twilio_cred_guide_img"/>
                        </div>
                    </div>

                    <!-- Tab 2: New Twilio Account -->
                    <div t-if="state.activeTab === 'new'" class="o_twilio_cred_help_pane">
                        <div class="o_twilio_cred_instructions mb-3">
                            <div class="d-flex align-items-start mb-2">
                                <span class="badge o_twilio_step_badge me-2 mt-1">1</span>
                                <div>Log in to your <a href="https://console.twilio.com" target="_blank" rel="noopener noreferrer">Twilio Console</a>. On the <strong>"Let's get building"</strong> home dashboard, click on <strong>API keys and Auth tokens &#8594;</strong></div>
                            </div>
                            <div class="d-flex align-items-start">
                                <span class="badge o_twilio_step_badge me-2 mt-1">2</span>
                                <div>Under <strong>Live credentials</strong>, find your <strong>Account SID</strong> and view/copy your <strong>Primary auth token</strong>.</div>
                            </div>
                        </div>
                        <div class="o_twilio_cred_image_container text-center">
                            <img src="/twilio_dialer_pro/static/src/img/twilio_new_console_credentials.png"
                                 alt="New Twilio Account Credentials Guide"
                                 class="img-fluid rounded border shadow-sm o_twilio_cred_guide_img"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Slot -->
            <t t-set-slot="footer">
                <div class="d-flex justify-content-end w-100 py-1">
                    <button type="button" class="btn btn-primary px-4" t-on-click="props.close">Close</button>
                </div>
            </t>
        </Dialog>
    </t>

</templates>
