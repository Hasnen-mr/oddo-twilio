<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="twilio_dialer_pro.NumberAllocationPanel">
        <div class="o_twilio_allocation_container w-100">

            <!-- Top Header Card -->
            <div class="o_twilio_cfg_card mb-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <div class="o_twilio_cfg_card_title d-flex align-items-center gap-2">
                            <i class="fa fa-list-ol text-primary"/>
                            <span>Number Allocation Manager</span>
                        </div>
                        <div class="o_twilio_cfg_card_sub mt-1">
                            Assign Twilio phone numbers to internal users. Users with <strong>All numbers</strong> can make and receive calls from any configured line.
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.loadData()" title="Refresh / Sync with Twilio">
                            <i class="fa fa-refresh me-1" t-att-class="{ 'fa-spin': state.loading }"/>
                            <span>Sync &amp; Refresh</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" t-on-click="() => this.resetAllToDefault()" title="Reset all users to All numbers">
                            <i class="fa fa-undo me-1"/>
                            <span>Reset All to Default</span>
                        </button>
                    </div>
                </div>

                <!-- Live Stats Cards -->
                <div class="row g-3 mt-2">
                    <div class="col-6 col-md-3">
                        <div class="o_twilio_stat_card p-3 rounded border bg-light">
                            <div class="text-muted small">Total Users</div>
                            <div class="fs-4 fw-bold text-dark" t-esc="stats.totalUsers"/>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_twilio_stat_card p-3 rounded border bg-light">
                            <div class="text-muted small">Full Access (All Lines)</div>
                            <div class="fs-4 fw-bold text-success" t-esc="stats.allAccessCount"/>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_twilio_stat_card p-3 rounded border bg-light">
                            <div class="text-muted small">Custom Assigned</div>
                            <div class="fs-4 fw-bold text-primary" t-esc="stats.customCount"/>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_twilio_stat_card p-3 rounded border bg-light">
                            <div class="text-muted small">Available Twilio Lines</div>
                            <div class="fs-4 fw-bold text-secondary" t-esc="stats.totalNumbers"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Allocation List Card -->
            <div class="o_twilio_cfg_card">
                <!-- Search & Filters Toolbar -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-3 mb-3 border-bottom">
                    <div class="o_twilio_search_box position-relative" style="min-width: 280px; max-width: 400px;">
                        <i class="fa fa-search position-absolute text-muted" style="left: 12px; top: 10px;"/>
                        <input type="text"
                               class="form-control form-control-sm ps-4"
                               placeholder="Search user by name or email..."
                               t-model="state.searchQuery"/>
                    </div>

                    <!-- Filter Tabs -->
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button"
                                class="btn"
                                t-att-class="state.filterTab === 'all' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.state.filterTab = 'all'">
                            All (<t t-esc="stats.totalUsers"/>)
                        </button>
                        <button type="button"
                                class="btn"
                                t-att-class="state.filterTab === 'default' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.state.filterTab = 'default'">
                            Full Access (<t t-esc="stats.allAccessCount"/>)
                        </button>
                        <button type="button"
                                class="btn"
                                t-att-class="state.filterTab === 'custom' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.state.filterTab = 'custom'">
                            Custom Assigned (<t t-esc="stats.customCount"/>)
                        </button>
                    </div>
                </div>

                <!-- Loading Spinner -->
                <div t-if="state.loading" class="text-center py-5">
                    <i class="fa fa-spinner fa-spin fa-2x text-primary"/>
                    <div class="text-muted mt-2">Loading number allocations...</div>
                </div>

                <!-- Allocation Table -->
                <div t-else="" class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="min-width: 200px;">User</th>
                                <th style="min-width: 220px;">Login / Email</th>
                                <th style="min-width: 300px;">Assigned Phone Numbers</th>
                                <th style="min-width: 140px;">Status</th>
                                <th style="min-width: 160px; text-align: right;">Quick Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="filteredAllocations.length === 0">
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fa fa-info-circle me-1"/>
                                    <span>No users match the search criteria.</span>
                                </td>
                            </tr>
                            <tr t-foreach="filteredAllocations" t-as="alloc" t-key="alloc.id">
                                <!-- User Column -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="o_twilio_user_avatar d-flex align-items-center justify-content-center rounded-circle text-white fw-bold"
                                             t-attf-style="background-color: {{ this.getUserColor(alloc.user_name) }}; width: 34px; height: 34px; font-size: 13px;">
                                            <t t-esc="this.getUserInitials(alloc.user_name)"/>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark" t-esc="alloc.user_name"/>
                                        </div>
                                    </div>
                                </td>

                                <!-- Login / Email Column -->
                                <td>
                                    <span class="text-muted small" t-esc="alloc.user_login || '—'"/>
                                </td>

                                <!-- Assigned Phone Numbers Column -->
                                <td>
                                    <div class="position-relative">
                                        <div class="d-flex flex-wrap align-items-center gap-1">
                                            <!-- All numbers pill -->
                                            <t t-if="this.isAllAssigned(alloc)">
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="fa fa-globe me-1"/>
                                                    <span>All numbers</span>
                                                </span>
                                            </t>
                                            <!-- Specific individual numbers -->
                                            <t t-else="">
                                                <t t-foreach="this.getAssignedNumberObjs(alloc)" t-as="numObj" t-key="numObj.id">
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 d-inline-flex align-items-center gap-1">
                                                        <i class="fa fa-phone small"/>
                                                        <span t-esc="numObj.friendly_name || numObj.phone_number"/>
                                                        <i class="fa fa-times text-danger ms-1 cursor-pointer"
                                                           title="Remove number"
                                                           style="cursor: pointer;"
                                                           t-on-click="() => this.quickRemoveNumber(alloc, numObj.id)"/>
                                                    </span>
                                                </t>
                                            </t>

                                            <!-- Edit / Assign Button -->
                                            <button type="button"
                                                    class="btn btn-xs btn-outline-secondary py-0 px-2 rounded-pill small"
                                                    style="font-size: 11px;"
                                                    t-on-click="() => this.openPicker(alloc)">
                                                <i class="fa fa-pencil me-1"/>
                                                <span>Edit</span>
                                            </button>
                                        </div>

                                        <!-- Number Picker Popover / Dropdown -->
                                        <div t-if="state.activeDropdownId === alloc.id"
                                             class="o_twilio_number_dropdown position-absolute p-3 bg-white border rounded shadow-lg"
                                             style="z-index: 1050; top: 100%; left: 0; min-width: 300px; max-width: 360px;">
                                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                                <span class="fw-bold small text-dark">Assign Numbers for <t t-esc="alloc.user_name"/></span>
                                                <i class="fa fa-times text-muted cursor-pointer" style="cursor: pointer;" t-on-click="() => this.closePicker()"/>
                                            </div>

                                            <div class="o_twilio_numbers_checklist" style="max-height: 200px; overflow-y: auto;">
                                                <t t-foreach="state.numbers" t-as="num" t-key="num.id">
                                                    <div class="form-check py-1">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               t-att-id="'chk_' + alloc.id + '_' + num.id"
                                                               t-att-checked="this.isDraftSelected(alloc.id, num.id)"
                                                               t-on-change="() => this.toggleDraftNumber(alloc.id, num)"/>
                                                        <label class="form-check-label small" t-att-for="'chk_' + alloc.id + '_' + num.id">
                                                            <t t-if="num.is_all">
                                                                <strong><i class="fa fa-globe text-success me-1"/>All numbers</strong>
                                                            </t>
                                                            <t t-else="">
                                                                <i class="fa fa-phone text-muted me-1"/>
                                                                <span t-esc="num.display_name"/>
                                                            </t>
                                                        </label>
                                                    </div>
                                                </t>
                                            </div>

                                            <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                                                <button type="button" class="btn btn-xs btn-light" t-on-click="() => this.closePicker()">Cancel</button>
                                                <button type="button"
                                                        class="btn btn-xs btn-primary"
                                                        t-att-disabled="state.savingId === alloc.id"
                                                        t-on-click="() => this.saveDraft(alloc)">
                                                    <i t-if="state.savingId === alloc.id" class="fa fa-spinner fa-spin me-1"/>
                                                    <span>Save Changes</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Allocation Status Column -->
                                <td>
                                    <span t-if="this.isAllAssigned(alloc)" class="badge bg-success text-white px-2 py-1 small">
                                        <i class="fa fa-check-circle me-1"/>All Numbers
                                    </span>
                                    <span t-else="" class="badge bg-info text-white px-2 py-1 small">
                                        <i class="fa fa-lock me-1"/><t t-esc="alloc.status"/>
                                    </span>
                                </td>

                                <!-- Quick Action Column -->
                                <td style="text-align: right;">
                                    <button t-if="!this.isAllAssigned(alloc)"
                                            type="button"
                                            class="btn btn-xs btn-outline-success py-1 px-2 small"
                                            title="Quickly assign all numbers to this user"
                                            t-att-disabled="state.savingId === alloc.id"
                                            t-on-click="() => this.quickSetAll(alloc)">
                                        <i class="fa fa-globe me-1"/>
                                        <span>Set to All</span>
                                    </button>
                                    <button t-else=""
                                            type="button"
                                            class="btn btn-xs btn-outline-primary py-1 px-2 small"
                                            title="Assign specific numbers"
                                            t-on-click="() => this.openPicker(alloc)">
                                        <i class="fa fa-sliders me-1"/>
                                        <span>Customize</span>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>

        </div>
    </t>

</templates>
