<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="twilio_dialer_pro.OnboardingWizard">
        <Dialog size="'lg'" contentClass="'o_twilio_onboard_dialog'">
            <t t-set-slot="header">
                <h5 class="modal-title" t-esc="dialogTitle"/>
                <button type="button" tabindex="-1" aria-label="Close" t-on-click="dismissWizard" style="position: absolute; top: 1rem; right: 1.5rem; z-index: 1050; cursor: pointer; font-size: 1.5rem; color: #9CA3AF; background: transparent; border: none; outline: none; box-shadow: none; padding: 0; line-height: 1; transition: color 0.15s ease-in-out;" onmouseover="this.style.color='#374151'" onmouseout="this.style.color='#9CA3AF'">&#215;</button>
            </t>
            <div class="o_twilio_onboard">
                <div class="o_twilio_onboard_progress">
                    <span class="o_twilio_onboard_step_label" t-esc="stepLabel"/>
                    <div class="o_twilio_onboard_dots">
                        <t t-foreach="[1,2,3,4,5]" t-as="n" t-key="n">
                            <span t-att-class="{
                                'o_twilio_onboard_dot': true,
                                'is-active': this.state.step === n,
                                'is-done': this.state.step &gt; n,
                            }"/>
                        </t>
                    </div>
                </div>

                <div class="o_twilio_onboard_body">
                    <!-- Step 1: Features Overview -->
                    <t t-if="this.state.step === 1">
                        <div class="o_twilio_onboard_icon">
                            <i class="fa fa-phone"/>
                        </div>
                        <h3 class="o_twilio_onboard_title">Calling &amp; SMS in one module</h3>
                        <p class="o_twilio_onboard_text">
                            Softphone, click-to-call, auto dialer, SMS, recordings, and AI
                            transcription — all inside Odoo with your own Twilio account.
                        </p>
                    </t>

                    <!-- Step 2: Pay-as-you-go Twilio Info -->
                    <t t-elif="this.state.step === 2">
                        <div class="o_twilio_onboard_icon">
                            <i class="fa fa-credit-card"/>
                        </div>
                        <h3 class="o_twilio_onboard_title">Twilio account required (upgraded)</h3>
                        <p class="o_twilio_onboard_text">
                            Create or upgrade a Twilio account to place and receive calls.
                            There is <strong>no subscription</strong> for this module —
                            Twilio uses a <strong>pay-as-you-go</strong> model for usage.
                        </p>
                        <ul class="o_twilio_onboard_list">
                            <li>No monthly module fee</li>
                            <li>Pay Twilio only for the minutes and messages you use</li>
                            <li>Full control of your Twilio credentials</li>
                        </ul>
                    </t>

                    <!-- Step 3: Enter Twilio Credentials & Connect -->
                    <t t-elif="this.state.step === 3">
                        <div class="o_twilio_onboard_icon">
                            <i class="fa fa-plug"/>
                        </div>
                        <h3 class="o_twilio_onboard_title">Configure Twilio credentials</h3>
                        <p class="o_twilio_onboard_text">
                            Enter your Twilio Account SID and Auth Token. Email and phone
                            are used for registration feedback.
                        </p>

                        <div class="o_twilio_onboard_form">
                            <label class="o_twilio_onboard_field">
                                <div class="d-flex justify-content-between align-items-center w-100 mb-1">
                                    <span>Account SID</span>
                                    <a href="#" class="o_twilio_find_cred_link" t-on-click.prevent="openCredentialsHelp">How to find?</a>
                                </div>
                                <input type="text"
                                       class="form-control"
                                       placeholder="ACxxxxxxxx"
                                       t-att-disabled="this.state.connecting or this.state.connected"
                                       t-model="this.state.accountSid"/>
                            </label>
                            <label class="o_twilio_onboard_field">
                                <div class="d-flex justify-content-between align-items-center w-100 mb-1">
                                    <span>Auth Token</span>
                                    <a href="#" class="o_twilio_find_cred_link" t-on-click.prevent="openCredentialsHelp">How to find?</a>
                                </div>
                                <input type="password"
                                       class="form-control"
                                       placeholder="Your Auth Token"
                                       t-att-disabled="this.state.connecting or this.state.connected"
                                       t-model="this.state.authToken"/>
                            </label>
                            <label class="o_twilio_onboard_field">
                                <span>Email</span>
                                <input type="email"
                                       class="form-control"
                                       placeholder="you@company.com"
                                       t-att-disabled="this.state.connecting or this.state.connected"
                                       t-model="this.state.email"/>
                            </label>
                            <label class="o_twilio_onboard_field">
                                <span>Phone</span>
                                <input type="tel"
                                       class="form-control"
                                       placeholder="+1…"
                                       t-att-disabled="this.state.connecting or this.state.connected"
                                       t-model="this.state.phone"/>
                            </label>
                        </div>

                        <t t-if="this.state.error">
                            <div class="alert alert-danger o_twilio_onboard_error" role="alert"
                                 t-esc="this.state.error"/>
                        </t>
                    </t>

                    <!-- Step 4: Email Verification -->
                    <t t-elif="this.state.step === 4">
                        <div class="o_twilio_onboard_icon">
                            <i class="fa fa-envelope-o text-primary"/>
                        </div>
                        <h3 class="o_twilio_onboard_title">Email Verification</h3>

                        <t t-if="!this.state.isEditingEmail">
                            <p class="o_twilio_onboard_text mb-2">
                                We sent a 6-digit verification code to:
                                <br/>
                                <span class="d-inline-flex align-items-center justify-content-center gap-2 mt-1 flex-wrap">
                                    <span class="o_twilio_onboard_email_highlight fw-semibold" t-esc="this.state.email"/>
                                    <button type="button" class="btn btn-link p-0 text-decoration-none fw-semibold" style="color: #714b67; font-size: 0.85rem;" t-on-click="startEditingEmail">
                                        <i class="fa fa-pencil me-1"/>Change
                                    </button>
                                </span>
                            </p>
                        </t>
                        <t t-else="">
                            <div class="o_twilio_onboard_text mb-2">
                                <div class="mb-1 text-muted" style="font-size: 0.85rem;">Correct your email address:</div>
                                <div class="d-flex align-items-center justify-content-center gap-2" style="max-width: 380px; margin: 0 auto;">
                                    <input type="email" class="form-control form-control-sm" placeholder="you@company.com" t-model="this.state.newEmail" style="max-width: 220px;"/>
                                    <button type="button" class="btn btn-sm btn-primary text-nowrap" t-on-click="saveAndResendNewEmail" t-att-disabled="this.state.sendingOtp or !this.state.newEmail">
                                        <t t-if="this.state.sendingOtp">
                                            <i class="fa fa-spinner fa-spin me-1"/>
                                        </t>
                                        Save &amp; Send
                                    </button>
                                    <button type="button" class="btn btn-sm btn-light border" t-on-click="cancelEditingEmail" t-att-disabled="this.state.sendingOtp">Cancel</button>
                                </div>
                            </div>
                        </t>

                        <div class="o_twilio_onboard_form mt-2" style="max-width: 380px; margin: 0 auto;">
                            <label class="o_twilio_onboard_field text-center">
                                <span class="mb-2" style="color: #6C757D; font-size: 0.85rem; font-weight: 600;">ENTER 6-DIGIT CODE</span>
                                <input type="text"
                                       class="form-control text-center o_twilio_otp_input"
                                       placeholder="123456"
                                       maxlength="6"
                                       autofocus="autofocus"
                                       t-att-disabled="this.state.verifyingOtp or this.state.emailVerified"
                                       t-model="this.state.otp"
                                       t-on-keydown="onOtpKeydown"/>
                            </label>

                            <div class="text-center mt-3 pt-1">
                                <button type="button"
                                        class="btn btn-link p-0 text-decoration-none fw-semibold"
                                        style="font-size: 0.88rem; color: #714b67;"
                                        t-att-disabled="this.state.sendingOtp or this.state.verifyingOtp"
                                        t-on-click="onResendOtp">
                                    <t t-if="this.state.sendingOtp">
                                        <i class="fa fa-spinner fa-spin me-1"/> Sending new code…
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-refresh me-1"/> Resend Email
                                    </t>
                                </button>
                                <div class="mt-1" style="font-size: 0.78rem; color: #6C757D;">
                                    <i class="fa fa-info-circle me-1"/>If you don't see the email, please check your <strong>Spam / Junk</strong> folder.
                                </div>
                            </div>

                            <!-- Allow Incoming Call Switch Group -->
                            <div class="o_twilio_onboard_field_group mt-3 p-3 rounded" style="background: #F8F9FA; border: 1px solid #E9ECEF; border-radius: 8px;">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="text-start pe-2">
                                        <div style="color: #212529; font-weight: 600; font-size: 0.92rem;">Allow Incoming call</div>
                                        <div style="color: #6C757D; font-size: 0.8rem; margin-top: 2px;">
                                            <t t-if="this.state.allowIncomingCall">Incoming is ON from your Call Settings. You can change this later.</t>
                                            <t t-else="">Incoming is OFF from your Call Settings. You can change this later.</t>
                                        </div>
                                    </div>
                                    <div class="form-check form-switch m-0" style="padding-left: 2.5em;">
                                        <input class="form-check-input" type="checkbox" role="switch" id="allowIncomingCallSwitch"
                                               t-model="this.state.allowIncomingCall"
                                               t-on-change="onToggleIncomingCall"
                                               t-att-disabled="this.state.verifyingOtp"
                                               style="width: 2.8rem; height: 1.4rem; cursor: pointer;"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <t t-if="this.state.otpSuccessMessage">
                            <div class="alert alert-success o_twilio_onboard_error mt-3 py-2 text-center" role="alert"
                                 t-esc="this.state.otpSuccessMessage"/>
                        </t>

                        <t t-if="this.state.otpError">
                            <div class="alert alert-danger o_twilio_onboard_error mt-3 py-2 text-center" role="alert"
                                 t-esc="this.state.otpError"/>
                        </t>
                    </t>

                    <!-- Step 5: Setup Complete / Registering Softphone Token -->
                    <t t-elif="this.state.step === 5">
                        <t t-if="this.state.registeringToken">
                            <div class="o_twilio_onboard_icon">
                                <i class="fa fa-spinner fa-spin"/>
                            </div>
                            <h3 class="o_twilio_onboard_title">Connecting to Twilio…</h3>
                            <p class="o_twilio_onboard_text">
                                Registering your softphone voice token. Please wait a moment…
                            </p>
                        </t>
                        <t t-elif="this.state.tokenReady">
                            <div class="o_twilio_onboard_icon o_twilio_onboard_icon--success">
                                <i class="fa fa-check"/>
                            </div>
                            <h3 class="o_twilio_onboard_title">Setup complete — you're ready to call</h3>
                            <p class="o_twilio_onboard_text">
                                Twilio credentials and email are verified, and your softphone token is registered successfully.
                            </p>
                        </t>
                        <t t-else="">
                            <div class="o_twilio_onboard_icon">
                                <i class="fa fa-exclamation-triangle text-warning" style="font-size: 2.5rem;"/>
                            </div>
                            <h3 class="o_twilio_onboard_title">Almost ready — connection needs attention</h3>
                            <p class="o_twilio_onboard_text">
                                Your Twilio credentials and email were verified successfully, but the softphone token registration needs attention.
                            </p>
                            <t t-if="this.state.error">
                                <div class="alert alert-warning o_twilio_onboard_error" role="alert"
                                     t-esc="this.state.error"/>
                            </t>
                        </t>
                    </t>
                </div>
            </div>

            <t t-set-slot="footer">
                <!-- Step 1 & 2 Footer -->
                <t t-if="this.state.step &lt; 3">
                    <t t-if="this.state.step &gt; 1">
                        <button type="button" class="btn btn-secondary"
                                t-on-click="prevStep">
                            Back
                        </button>
                    </t>
                    <button type="button" class="btn btn-primary ms-auto"
                            t-on-click="nextStep">
                        Next
                    </button>
                </t>

                <!-- Step 3 Footer -->
                <t t-elif="this.state.step === 3">
                    <button type="button" class="btn btn-secondary"
                            t-att-disabled="this.state.connecting"
                            t-on-click="prevStep">
                        Back
                    </button>
                    <button type="button" class="btn btn-primary o_twilio_onboard_connect ms-auto"
                            t-att-disabled="!canConnect"
                            t-on-click="onConnect">
                        <t t-if="this.state.connecting">
                            <i class="fa fa-spinner fa-spin me-1"/> Connecting…
                        </t>
                        <t t-else="">
                            Connect
                        </t>
                    </button>
                </t>

                <!-- Step 4 Footer (Email Verification) -->
                <t t-elif="this.state.step === 4">
                    <button type="button" class="btn btn-secondary"
                            t-att-disabled="this.state.verifyingOtp"
                            t-on-click="prevStep">
                        Back
                    </button>
                    <button type="button" class="btn btn-primary ms-auto"
                            t-att-disabled="this.state.verifyingOtp or !this.state.otp"
                            t-on-click="verifyOtp">
                        <t t-if="this.state.verifyingOtp">
                            <i class="fa fa-spinner fa-spin me-1"/> Verifying…
                        </t>
                        <t t-else="">
                            <i class="fa fa-check-circle me-1"/> Verify Code
                        </t>
                    </button>
                </t>

                <!-- Step 5 Footer (Complete) -->
                <t t-elif="this.state.step === 5">
                    <t t-if="this.state.registeringToken">
                        <button type="button" class="btn btn-primary ms-auto" disabled="disabled">
                            <i class="fa fa-spinner fa-spin me-1"/> Registering…
                        </button>
                    </t>
                    <t t-elif="this.state.tokenReady">
                        <button type="button" class="btn btn-success ms-auto"
                                t-on-click="openDialer">
                            <i class="fa fa-phone me-1"/> Open Dialer
                        </button>
                    </t>
                    <t t-else="">
                        <button type="button" class="btn btn-secondary me-2"
                                t-on-click="onCheckCredentials">
                            Check Credentials
                        </button>
                        <button type="button" class="btn btn-primary ms-auto"
                                t-on-click="registerToken">
                            <i class="fa fa-refresh me-1"/> Retry Registration
                        </button>
                    </t>
                </t>
            </t>
        </Dialog>
    </t>

</templates>