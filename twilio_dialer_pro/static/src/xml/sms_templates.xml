<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Shared Contact SMS Button (used beside call button) -->
    <t t-name="twilio_dialer_pro.ContactSmsButton">
        <button type="button"
                class="o_twilio_contact_sms_button"
                t-att-disabled="!phone"
                t-att-title="phone ? 'Send SMS via Twilio' : 'No phone number available.'"
                t-on-click.stop="openSms">
            <i class="fa fa-comment" aria-label="SMS"/>
        </button>
    </t>

    <!-- SMS Popup Modal & Embedded Live Chat View -->
    <t t-name="twilio_dialer_pro.TwilioSmsPopup">
        <div class="o_twilio_sms_modal_backdrop" t-on-click.self="onCancel">
            <div t-att-class="this.props.isEmbedded ? 'o_twilio_sms_modal o_twilio_sms_modal--embedded' : 'o_twilio_sms_modal'">

                <!-- Header -->
                <div class="o_twilio_sms_header">
                    <div class="o_twilio_sms_header_info">
                        <div class="o_twilio_sms_avatar">
                            <i class="fa fa-user"/>
                        </div>
                        <div class="o_twilio_sms_title_block">
                            <h3 class="o_twilio_sms_contact_name" t-esc="this.props.partnerName || 'Contact'"/>
                            <div class="o_twilio_sms_subtitle d-flex align-items-center gap-2">
                                <span class="o_twilio_sms_phone" t-esc="this.props.phone"/>
                                <t t-if="this.state.messageText.trim()">
                                    <span class="badge bg-warning text-dark border border-warning micro">
                                        <i class="fa fa-pencil me-1"/>Draft
                                    </span>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-none" t-on-click="(ev) => this.makeCall(ev)" title="Call via Twilio Softphone">
                            <i class="fa fa-phone me-1"/>Call
                        </button>
                        <t t-if="!this.props.isEmbedded">
                            <button type="button" class="btn-close ms-2" t-on-click="onCancel" title="Close" aria-label="Close"/>
                        </t>
                    </div>
                </div>

                <!-- Search Bar inside Conversation -->
                <div class="o_twilio_sms_search_box px-3 py-2 bg-light border-bottom">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fa fa-search text-muted"/>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 shadow-none ps-0"
                               placeholder="Search in conversation..."
                               t-model="this.state.searchQuery"/>
                    </div>
                </div>

                <!-- Chat Body (Messages or Skeleton) -->
                <div class="o_twilio_sms_body" t-ref="chatBody" t-on-scroll="onScroll">
                    <t t-if="this.state.loading">
                        <!-- Short Smooth Skeleton Loading State -->
                        <div class="o_twilio_sms_skeleton_body">
                            <div class="o_twilio_skeleton_bubble o_twilio_skeleton_bubble--in" style="width: 45%;"/>
                            <div class="o_twilio_skeleton_bubble o_twilio_skeleton_bubble--out" style="width: 60%;"/>
                            <div class="o_twilio_skeleton_bubble o_twilio_skeleton_bubble--in" style="width: 35%;"/>
                            <div class="o_twilio_skeleton_bubble o_twilio_skeleton_bubble--out" style="width: 50%;"/>
                        </div>
                    </t>
                    <t t-elif="this.state.errorState and (!this.state.messages or this.state.messages.length === 0)">
                        <div class="o_twilio_sms_empty text-danger px-4">
                            <i class="fa fa-exclamation-triangle fa-2x mb-2 text-danger opacity-75"/>
                            <h6 class="fw-bold mb-1">Unable to load conversation</h6>
                            <p class="small text-muted text-center" t-esc="this.state.errorMessage"/>
                        </div>
                    </t>
                    <t t-elif="filteredMessages.length === 0">
                        <div class="o_twilio_sms_empty px-4">
                            <i class="fa fa-comments-o fa-3x mb-2 text-muted opacity-50"/>
                            <h6 class="fw-bold text-slate-700 mb-1">No SMS conversation yet</h6>
                            <p class="small text-muted text-center">Start the conversation by sending your first message.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <t t-if="this.state.loadingMore">
                            <div class="text-center py-2 text-muted small">
                                <i class="fa fa-spinner fa-spin me-1"/> Loading older messages...
                            </div>
                        </t>

                        <div class="o_twilio_sms_chat_list">
                            <t t-foreach="filteredMessages || []" t-as="msg" t-key="msg.id || msg.sid">
                                <div t-att-class="msg.direction === 'inbound' or msg.direction === 'incoming' ? 'o_twilio_sms_msg o_twilio_sms_msg--inbound' : 'o_twilio_sms_msg o_twilio_sms_msg--outbound'">
                                    <div class="o_twilio_sms_msg_sender">
                                        <t t-if="msg.direction === 'inbound' or msg.direction === 'incoming'">
                                            <t t-esc="this.props.partnerName || 'Contact'"/>
                                        </t>
                                        <t t-else="">
                                            You
                                        </t>
                                    </div>
                                    <div class="o_twilio_sms_msg_bubble">
                                        <div class="o_twilio_sms_msg_text" t-esc="msg.body"/>
                                        <div class="o_twilio_sms_msg_meta">
                                            <span class="o_twilio_sms_msg_time" t-esc="msg.create_date || msg.date_sent || ''"/>
                                            <t t-if="msg.status === 'delivered' or msg.status === 'sent' or msg.status === 'received'">
                                                <span class="o_twilio_sms_msg_status text-success" title="Delivered">
                                                    <i class="fa fa-check"/>
                                                </span>
                                            </t>
                                            <t t-elif="msg.status === 'failed' or msg.status === 'undelivered'">
                                                <span class="o_twilio_sms_msg_status text-danger" title="Delivery Failed">
                                                    <i class="fa fa-exclamation-circle"/>
                                                </span>
                                            </t>
                                        </div>
                                    </div>
                                    <t t-if="msg.status === 'failed' or msg.status === 'undelivered'">
                                        <div class="o_twilio_sms_msg_failed_bar">
                                            <span class="text-danger small"><i class="fa fa-times-circle me-1"/>Failed</span>
                                            <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-2 text-decoration-none" t-on-click="() => this.openRetryConfirm(msg)">
                                                <i class="fa fa-repeat me-1"/>Retry Sending
                                            </button>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>

                <!-- Footer: Composer & Controls -->
                <div class="o_twilio_sms_footer">
                    <!-- Templates & Quick Replies Toolbar -->
                    <div class="o_twilio_sms_toolbar">
                        <div class="o_twilio_sms_templates_row d-flex align-items-center justify-content-between">
                            <select class="form-select form-select-sm o_twilio_sms_template_select w-auto" t-on-change="onSelectTemplate">
                                <option value="">Templates ▼</option>
                                <t t-foreach="this.state.templates || []" t-as="tmpl" t-key="tmpl.id">
                                    <option t-att-value="tmpl.id" t-esc="tmpl.name"/>
                                </t>
                            </select>

                            <div class="o_twilio_sms_char_counter small text-muted">
                                <span class="fw-semibold" t-esc="charInfo.length"/> chars
                                <span class="mx-1">•</span>
                                <span class="badge bg-light text-dark border"><t t-esc="charInfo.segments"/> SMS</span>
                                <span class="mx-1">•</span>
                                <span t-esc="charInfo.available"/> available
                            </div>
                        </div>

                        <!-- Quick Reply Pills Carousel -->
                        <t t-if="this.state.quickReplies and this.state.quickReplies.length > 0">
                            <div class="o_twilio_quick_replies_carousel d-flex gap-1 overflow-auto py-1">
                                <t t-foreach="this.state.quickReplies || []" t-as="reply" t-key="reply.id">
                                    <button type="button" class="badge rounded-pill bg-light text-slate-700 border o_twilio_quick_reply_pill text-nowrap" t-on-click="() => this.onInsertQuickReply(reply.text)">
                                        <t t-esc="reply.label || reply.text"/>
                                    </button>
                                </t>
                            </div>
                        </t>
                    </div>

                    <textarea class="o_twilio_sms_textarea"
                              t-ref="messageInput"
                              placeholder="Type a message (Enter to send, Shift+Enter for new line)..."
                              t-model="this.state.messageText"
                              t-on-input="onInputMessage"
                              t-on-keydown="onKeyDownTextarea"
                              t-att-disabled="this.state.sending"/>

                    <div class="o_twilio_sms_actions">
                        <button type="button" class="btn btn-outline-secondary btn-sm me-auto" t-on-click="openPreview" t-att-disabled="this.state.sending || !this.state.messageText.trim()">
                            <i class="fa fa-eye me-1"/> Preview
                        </button>
                        <t t-if="!this.props.isEmbedded">
                            <button type="button" class="btn btn-secondary o_twilio_sms_btn_cancel" t-on-click="onCancel" t-att-disabled="this.state.sending">
                                Cancel
                            </button>
                        </t>
                        <button type="button" class="btn btn-primary o_twilio_sms_btn_send px-4" t-on-click="onSend" t-att-disabled="this.state.sending || !this.state.messageText.trim()">
                            <t t-if="this.state.sending">
                                <i class="fa fa-spinner fa-spin me-1"/> Sending...
                            </t>
                            <t t-else="">
                                <i class="fa fa-paper-plane me-1"/> Send
                            </t>
                        </button>
                    </div>
                </div>

                <!-- Message Preview Modal -->
                <t t-if="this.state.showPreviewModal">
                    <div class="o_twilio_sms_modal_backdrop style-preview-layer" t-on-click.self="closePreview">
                        <div class="card shadow-lg p-3 o_twilio_preview_card">
                            <div class="card-header bg-white border-0 p-0 mb-2 d-flex justify-content-between align-items-center">
                                <h5 class="fw-bold m-0"><i class="fa fa-paper-plane text-primary me-2"/>Message Preview</h5>
                                <button type="button" class="btn-close" t-on-click="closePreview"/>
                            </div>
                            <div class="card-body p-0 small">
                                <div class="mb-2"><strong>Recipient:</strong> <t t-esc="this.props.partnerName || 'Contact'"/></div>
                                <div class="mb-2"><strong>Phone:</strong> <t t-esc="normalizedPhone || this.props.phone"/></div>
                                <div class="mb-2"><strong>Segments:</strong> <t t-esc="charInfo.segments"/> SMS</div>
                                <div class="mb-2"><strong>Final Rendered Message:</strong></div>
                                <div class="p-2 bg-light rounded border mb-3 text-wrap text-break fw-normal" t-esc="this.state.messageText"/>
                            </div>
                            <div class="card-footer bg-white border-0 p-0 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary btn-sm" t-on-click="closePreview">Cancel</button>
                                <button type="button" class="btn btn-primary btn-sm" t-on-click="confirmSendFromPreview">Send</button>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- Retry Sending Confirmation Modal -->
                <t t-if="this.state.retryTargetMsg">
                    <div class="o_twilio_sms_modal_backdrop style-preview-layer" t-on-click.self="closeRetryConfirm">
                        <div class="card shadow-lg p-3 o_twilio_preview_card">
                            <div class="card-header bg-white border-0 p-0 mb-2 d-flex justify-content-between align-items-center">
                                <h5 class="fw-bold m-0 text-danger"><i class="fa fa-repeat me-2"/>Confirm Retry Sending</h5>
                                <button type="button" class="btn-close" t-on-click="closeRetryConfirm"/>
                            </div>
                            <div class="card-body p-0 small">
                                <p>Are you sure you want to retry sending this failed SMS?</p>
                                <div class="p-2 bg-light rounded border mb-3 text-wrap text-break" t-esc="this.state.retryTargetMsg.body"/>
                            </div>
                            <div class="card-footer bg-white border-0 p-0 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary btn-sm" t-on-click="closeRetryConfirm">Cancel</button>
                                <button type="button" class="btn btn-danger btn-sm" t-on-click="confirmRetrySending">Retry Sending</button>
                            </div>
                        </div>
                    </div>
                </t>

            </div>
        </div>
    </t>

</templates>
