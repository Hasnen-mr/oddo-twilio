<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Number Allocation Inline Editable List/Tree View -->
    <record id="view_twilio_number_allocation_tree" model="ir.ui.view">
        <field name="name">twilio.number.allocation.list</field>
        <field name="model">twilio.number.allocation</field>
        <field name="arch" type="xml">
            <list string="Number Allocation" editable="bottom" create="false" delete="false">
                <field name="user_id" string="User" readonly="1"/>
                <field name="user_login" string="Login / Email" readonly="1"/>
                <field name="twilio_number_ids" widget="many2many_tags" string="Assigned Numbers" options="{'no_create': True}"/>
                <field name="allocation_status" string="Allocation Status" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Number Allocation Search View -->
    <record id="view_twilio_number_allocation_search" model="ir.ui.view">
        <field name="name">twilio.number.allocation.search</field>
        <field name="model">twilio.number.allocation</field>
        <field name="arch" type="xml">
            <search string="Search Number Allocation">
                <field name="user_id" string="User"/>
                <field name="user_login" string="Login"/>
                <field name="twilio_number_ids" string="Twilio Number"/>
            </search>
        </field>
    </record>

    <!-- Number Allocation Action -->
    <record id="action_twilio_number_allocation" model="ir.actions.act_window">
        <field name="name">Number Allocation</field>
        <field name="res_model">twilio.number.allocation</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_twilio_number_allocation_tree"/>
        <field name="search_view_id" ref="view_twilio_number_allocation_search"/>
        <field name="domain">[('user_id.share', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Twilio Phone Number Allocations
            </p>
            <p>
                Assign Twilio phone numbers to internal Odoo users directly in this permission manager table.
            </p>
        </field>
    </record>

</odoo>