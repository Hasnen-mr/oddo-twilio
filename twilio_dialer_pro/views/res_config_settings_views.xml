<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form_twilio" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.twilio</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app string="Twilio Call Auto Dialer Pro" name="twilio_dialer_pro">
                    <field name="twilio_is_connected" invisible="1"/>
                    <field name="twilio_api_key_sid" invisible="1"/>
                    <field name="twilio_application_sid" invisible="1"/>
                    <field name="twilio_config_section" widget="twilio_config_nav" class="o_twilio_cfg_nav_field"/>

                    <!-- Connection overview (Account section) -->
                    <block name="twilio_connection_overview">
                        <div class="o_twilio_cfg_panel o_twilio_cfg_panel--account w-100">
                        <div class="o_twilio_cfg_banner w-100">
                            <div class="o_twilio_cfg_banner_left">
                                <div class="o_twilio_cfg_banner_title">Twilio connection</div>
                                <div class="o_twilio_cfg_banner_sub">
                                    Connect your Twilio account, set call behavior, then optionally enable AI transcripts.
                                </div>
                            </div>
                            <div class="o_twilio_cfg_banner_right">
                                <span class="o_twilio_cfg_status_pill">
                                    <field name="twilio_status" readonly="1" class="o_twilio_cfg_status_field"/>
                                </span>
                                <button name="action_remove_connection"
                                        type="object"
                                        string="Disconnect"
                                        icon="fa-unlink"
                                        class="btn btn-danger o_twilio_cfg_disconnect_btn"
                                        invisible="not twilio_is_connected"
                                        noSaveDialog="True"
                                        confirm="This will disconnect Twilio (delete API key / TwiML app when possible) and clear Account SID, Auth Token, and generated credentials. Continue?"/>
                            </div>
                        </div>
                        <div class="o_twilio_cfg_smart_note w-100 mt-2" invisible="twilio_is_connected">
                            <i class="fa fa-lock"/>
                            <span><strong>Call Settings</strong> and <strong>AI Settings</strong> unlock after you save valid Twilio credentials and connect.</span>
                        </div>
                        </div>
                    </block>

                    <!-- Account -->
                    <block name="twilio_account_details">
                        <div class="o_twilio_cfg_panel o_twilio_cfg_panel--account w-100">
                        <div class="o_twilio_cfg_grid w-100">
                            <div class="o_twilio_cfg_card">
                                <div class="o_twilio_cfg_card_title">Credentials</div>
                                <div class="o_twilio_cfg_card_sub">Used to authenticate with your Twilio account.</div>

                                <div class="o_twilio_cfg_smart_note">
                                    <i class="fa fa-magic"/>
                                    <span>Enter your <strong>Account SID</strong> and <strong>Auth Token</strong>, then click <strong>Save Credentials</strong>. Smart Tools creates the API key, TwiML app, and phone numbers, then refreshes this page.</span>
                                </div>

                                <div class="o_twilio_cfg_field">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label for="twilio_account_sid" class="o_twilio_cfg_label mb-0">Account SID</label>
                                        <button name="action_open_credentials_help" type="object" string="How to find?" class="btn btn-link p-0 o_twilio_find_cred_btn"/>
                                    </div>
                                    <field name="twilio_account_sid"
                                            class="o_twilio_cfg_input"
                                            placeholder="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"/>
                                </div>
                                <div class="o_twilio_cfg_field">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label for="twilio_auth_token" class="o_twilio_cfg_label mb-0">Auth Token</label>
                                        <button name="action_open_credentials_help" type="object" string="How to find?" class="btn btn-link p-0 o_twilio_find_cred_btn"/>
                                    </div>
                                    <field name="twilio_auth_token"
                                            widget="password_toggle"
                                            class="o_twilio_cfg_input"
                                            placeholder="Your Twilio Auth Token"/>
                                </div>
                                <div class="o_twilio_cfg_field">
                                    <label for="twilio_contact_email" class="o_twilio_cfg_label">Contact Email</label>
                                    <field name="twilio_contact_email"
                                            class="o_twilio_cfg_input"
                                            placeholder="you@company.com"
                                            widget="email"/>
                                </div>
                                <div class="o_twilio_cfg_field">
                                    <label for="twilio_contact_phone" class="o_twilio_cfg_label">Contact Phone</label>
                                    <field name="twilio_contact_phone"
                                            class="o_twilio_cfg_input"
                                            placeholder="+15551234567"/>
                                </div>

                                <div class="o_twilio_cfg_actions">
                                    <button name="action_save_twilio_credentials"
                                            type="object"
                                            string="Save Credentials"
                                            class="btn btn-primary"/>
                                    <button name="action_generate_configuration"
                                            type="object"
                                            string="Sync Again"
                                            class="btn btn-secondary"
                                            invisible="not twilio_is_connected"/>
                                </div>
                            </div>

                            <div class="o_twilio_cfg_card" invisible="not twilio_is_connected">
                                <div class="o_twilio_cfg_card_title">Generated connection</div>
                                <div class="o_twilio_cfg_card_sub">
                                    Read-only details created automatically when you save your credentials.
                                </div>

                                <div class="o_twilio_cfg_field">
                                    <label for="twilio_application_sid" class="o_twilio_cfg_label">Application SID</label>
                                    <div class="o_twilio_cfg_readonly_box">
                                        <field name="twilio_application_sid" readonly="1" nolabel="1"/>
                                    </div>
                                </div>
                                <div class="o_twilio_cfg_field">
                                    <label for="twilio_api_key_sid" class="o_twilio_cfg_label">API Key SID</label>
                                    <div class="o_twilio_cfg_readonly_box">
                                        <field name="twilio_api_key_sid" readonly="1" nolabel="1"/>
                                    </div>
                                </div>
                                <div class="o_twilio_cfg_field">
                                    <label for="twilio_api_secret" class="o_twilio_cfg_label">API Secret</label>
                                    <div class="o_twilio_cfg_readonly_box">
                                        <field name="twilio_api_secret"
                                                readonly="1"
                                                widget="password_toggle"
                                                nolabel="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        </div>
                    </block>

                    <!-- Call Settings -->
                    <block name="twilio_call_settings"
                           invisible="not twilio_is_connected">
                        <div class="o_twilio_cfg_panel o_twilio_cfg_panel--call w-100">
                        <field name="twilio_call_settings_error" invisible="1"/>
                        <field name="twilio_ai_api_key_issue" invisible="1"/>
                        <field name="twilio_call_settings_autosave"
                                widget="twilio_call_settings_autosave"
                                nolabel="1"
                                class="o_twilio_call_settings_autosave_field"/>
                        <div class="alert alert-warning w-100" role="alert" invisible="not twilio_call_settings_error">
                            <field name="twilio_call_settings_error" readonly="1"/>
                        </div>
                        <div class="o_twilio_cfg_grid w-100">
                            

                            <div class="o_twilio_cfg_card">
                                <div class="o_twilio_cfg_card_title">Incoming</div>
                                <div class="o_twilio_cfg_card_sub">How inbound Twilio calls behave in Odoo.</div>

                                <div class="o_twilio_cfg_switch_row o_twilio_cfg_switch_row--master">
                                    <div class="o_twilio_cfg_switch_text">
                                        <div class="o_twilio_cfg_label">Enable Incoming Calls</div>
                                        <div class="o_twilio_cfg_hint">Allow receiving calls in the dialer.</div>
                                    </div>
                                    <field name="twilio_incoming_enabled" widget="boolean_toggle" class="o_twilio_cfg_switch"/>
                                </div>

                                <div class="o_twilio_cfg_incoming_options" invisible="not twilio_incoming_enabled">
                                    <div class="o_twilio_cfg_switch_row">
                                        <div class="o_twilio_cfg_switch_text">
                                            <div class="o_twilio_cfg_label">Record Incoming</div>
                                            <div class="o_twilio_cfg_hint">Save recordings when available.</div>
                                        </div>
                                        <field name="twilio_incoming_record" widget="boolean_toggle" class="o_twilio_cfg_switch"/>
                                    </div>
                                    <div class="o_twilio_cfg_switch_row">
                                        <div class="o_twilio_cfg_switch_text">
                                            <div class="o_twilio_cfg_label">Enable Transcription</div>
                                            <div class="o_twilio_cfg_hint">Transcribe recorded incoming calls.</div>
                                        </div>
                                        <field name="twilio_incoming_transcription" widget="boolean_toggle" class="o_twilio_cfg_switch"/>
                                    </div>
                                    <div class="o_twilio_cfg_api_warn"
                                         invisible="not twilio_incoming_transcription or not twilio_ai_api_key_issue">
                                        <i class="fa fa-exclamation-triangle"/>
                                        <div class="o_twilio_cfg_api_warn_body">
                                            <span>API key is not set, or API key is not valid.</span>
                                            <field name="twilio_ai_settings_link"
                                                   widget="twilio_ai_settings_link"
                                                   options="{'label': 'Open AI Settings'}"
                                                   nolabel="1"/>
                                        </div>
                                    </div>
                                    <div class="o_twilio_cfg_switch_row">
                                        <div class="o_twilio_cfg_switch_text">
                                            <div class="o_twilio_cfg_label">Welcome Greeting</div>
                                            <div class="o_twilio_cfg_hint">Play a greeting message before connecting the call.</div>
                                        </div>
                                        <field name="twilio_incoming_welcome_greeting" widget="boolean_toggle" class="o_twilio_cfg_switch"/>
                                    </div>
                                    <div class="o_twilio_cfg_field" invisible="not twilio_incoming_welcome_greeting">
                                        <label for="twilio_incoming_welcome_greeting_text" class="o_twilio_cfg_label">Greeting Message Text</label>
                                        <field name="twilio_incoming_welcome_greeting_text" class="o_twilio_cfg_input"/>
                                    </div>
                                    <div class="o_twilio_cfg_switch_row">
                                        <div class="o_twilio_cfg_switch_text">
                                            <div class="o_twilio_cfg_label">Voicemail if Unanswered</div>
                                            <div class="o_twilio_cfg_hint">Route missed calls to voicemail.</div>
                                        </div>
                                        <field name="twilio_incoming_voicemail" widget="boolean_toggle" class="o_twilio_cfg_switch"/>
                                    </div>
                                    <div class="o_twilio_cfg_field" invisible="not twilio_incoming_voicemail">
                                        <label for="twilio_incoming_voicemail_text" class="o_twilio_cfg_label">Voicemail Text</label>
                                        <field name="twilio_incoming_voicemail_text" class="o_twilio_cfg_input"/>
                                    </div>
                                    <div class="o_twilio_cfg_switch_row">
                                        <div class="o_twilio_cfg_switch_text">
                                            <div class="o_twilio_cfg_label">Forward Calls</div>
                                            <div class="o_twilio_cfg_hint">Send inbound calls to another number.</div>
                                        </div>
                                        <field name="twilio_incoming_forward" widget="boolean_toggle" class="o_twilio_cfg_switch"/>
                                    </div>
                                    <div class="o_twilio_cfg_field" invisible="not twilio_incoming_forward">
                                        <label for="twilio_incoming_forward_to" class="o_twilio_cfg_label">Forward To</label>
                                        <field name="twilio_incoming_forward_to"
                                                widget="twilio_phone_country"
                                                class="o_twilio_cfg_input o_twilio_forward_to_field"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_twilio_cfg_card">
                                <div class="o_twilio_cfg_card_title">Outgoing</div>
                                <div class="o_twilio_cfg_card_sub">Defaults for outbound dialer calls.</div>

                                <div class="o_twilio_cfg_switch_row">
                                    <div class="o_twilio_cfg_switch_text">
                                        <div class="o_twilio_cfg_label">Record Outgoing</div>
                                        <div class="o_twilio_cfg_hint">Record outbound calls when supported.</div>
                                    </div>
                                    <field name="twilio_outgoing_record" widget="boolean_toggle" class="o_twilio_cfg_switch"/>
                                </div>
                                <div class="o_twilio_cfg_switch_row">
                                    <div class="o_twilio_cfg_switch_text">
                                        <div class="o_twilio_cfg_label">Enable Transcription</div>
                                        <div class="o_twilio_cfg_hint">Transcribe recorded outgoing calls.</div>
                                    </div>
                                    <field name="twilio_outgoing_transcription" widget="boolean_toggle" class="o_twilio_cfg_switch"/>
                                </div>
                                <div class="o_twilio_cfg_api_warn"
                                     invisible="not twilio_outgoing_transcription or not twilio_ai_api_key_issue">
                                    <i class="fa fa-exclamation-triangle"/>
                                    <div class="o_twilio_cfg_api_warn_body">
                                        <span>API key is not set, or API key is not valid.</span>
                                        <field name="twilio_ai_settings_link"
                                               widget="twilio_ai_settings_link"
                                               options="{'label': 'Open AI Settings'}"
                                               nolabel="1"/>
                                    </div>
                                </div>
                                <div class="o_twilio_cfg_switch_row">
                                    <div class="o_twilio_cfg_switch_text">
                                        <div class="o_twilio_cfg_label">Smart Copy</div>
                                        <div class="o_twilio_cfg_hint">Enable Smart Copy for outgoing calls.</div>
                                    </div>
                                    <field name="twilio_outgoing_smart_copy" widget="boolean_toggle" class="o_twilio_cfg_switch"/>
                                </div>
                            </div>
                        </div>
                        </div>
                    </block>

                    <!-- Number Allocation Settings -->
                    <block name="twilio_number_allocation_settings"
                           invisible="not twilio_is_connected">
                        <div class="o_twilio_cfg_panel o_twilio_cfg_panel--allocation w-100">
                            <field name="twilio_allocation_panel" widget="twilio_allocation_panel" nolabel="1" class="w-100 o_twilio_cfg_allocation_field"/>
                        </div>
                    </block>

                    <!-- AI Settings -->
                    <block name="twilio_ai_settings"
                           invisible="not twilio_is_connected">
                        <div class="o_twilio_cfg_panel o_twilio_cfg_panel--ai w-100">
                        <div class="o_twilio_cfg_grid w-100">
                            <div class="o_twilio_cfg_card">
                                <div class="o_twilio_cfg_card_title">Providers</div>
                                <div class="o_twilio_cfg_card_sub">Choose a provider, then enter only that provider’s API key.</div>

                                <div class="o_twilio_cfg_field">
                                    <label for="twilio_ai_provider" class="o_twilio_cfg_label">Default AI Provider</label>
                                    <field name="twilio_ai_provider" class="o_twilio_cfg_input"/>
                                </div>
                                <div class="o_twilio_cfg_field" invisible="twilio_ai_provider != 'openai'">
                                    <label for="twilio_openai_api_key" class="o_twilio_cfg_label">OpenAI API Key</label>
                                    <field name="twilio_openai_api_key" password="True" class="o_twilio_cfg_input" placeholder="sk-..."/>
                                </div>
                                <div class="o_twilio_cfg_field" invisible="twilio_ai_provider != 'openai'">
                                    <label for="twilio_openai_speech_model" class="o_twilio_cfg_label">OpenAI Speech Model</label>
                                    <field name="twilio_openai_speech_model" class="o_twilio_cfg_input"/>
                                </div>
                                <div class="o_twilio_cfg_field" invisible="twilio_ai_provider != 'anthropic'">
                                    <label for="twilio_anthropic_api_key" class="o_twilio_cfg_label">Anthropic API Key</label>
                                    <field name="twilio_anthropic_api_key" password="True" class="o_twilio_cfg_input" placeholder="sk-ant-..."/>
                                </div>
                                <div class="o_twilio_cfg_field" invisible="twilio_ai_provider != 'gemini'">
                                    <label for="twilio_gemini_api_key" class="o_twilio_cfg_label">Google Gemini API Key</label>
                                    <field name="twilio_gemini_api_key" password="True" class="o_twilio_cfg_input"/>
                                </div>
                                <div class="o_twilio_cfg_field" invisible="twilio_ai_provider != 'deepgram'">
                                    <label for="twilio_deepgram_api_key" class="o_twilio_cfg_label">Deepgram API Key</label>
                                    <field name="twilio_deepgram_api_key" password="True" class="o_twilio_cfg_input"/>
                                </div>
                            </div>

                            <div class="o_twilio_cfg_card">
                                <div class="o_twilio_cfg_card_title">Transcript &amp; Summary</div>
                                <div class="o_twilio_cfg_card_sub">Create AI output on call logs after calls finish.</div>

                                <div class="o_twilio_cfg_switch_row">
                                    <div class="o_twilio_cfg_switch_text">
                                        <div class="o_twilio_cfg_label">Create Transcript</div>
                                        <div class="o_twilio_cfg_hint">Generate text transcript from notes/recording.</div>
                                    </div>
                                    <field name="twilio_ai_enable_transcript" widget="boolean_toggle" class="o_twilio_cfg_switch"/>
                                </div>
                                <div class="o_twilio_cfg_api_warn"
                                     invisible="not twilio_ai_enable_transcript or not twilio_ai_api_key_issue">
                                    <i class="fa fa-exclamation-triangle"/>
                                    <span>API key is not set, or API key is not valid.</span>
                                </div>
                                <div class="o_twilio_cfg_switch_row">
                                    <div class="o_twilio_cfg_switch_text">
                                        <div class="o_twilio_cfg_label">Create Summary</div>
                                        <div class="o_twilio_cfg_hint">Generate a short CRM-friendly call summary.</div>
                                    </div>
                                    <field name="twilio_ai_enable_summary" widget="boolean_toggle" class="o_twilio_cfg_switch"/>
                                </div>
                                <div class="o_twilio_cfg_switch_row">
                                    <div class="o_twilio_cfg_switch_text">
                                        <div class="o_twilio_cfg_label">Auto on Complete</div>
                                        <div class="o_twilio_cfg_hint">Run enabled AI actions when a call completes.</div>
                                    </div>
                                    <field name="twilio_ai_auto_on_complete" widget="boolean_toggle" class="o_twilio_cfg_switch"/>
                                </div>
                            </div>
                        </div>
                        </div>
                    </block>

                    <!-- Billing -->
                    <block name="twilio_billing_settings"
                           invisible="not twilio_is_connected">
                        <div class="o_twilio_cfg_panel o_twilio_cfg_panel--billing w-100">
                        <field name="twilio_billing_panel" widget="twilio_billing_panel" nolabel="1" class="w-100 o_twilio_cfg_billing_field"/>
                        </div>
                    </block>

                </app>

            </xpath>

        </field>
    </record>

</odoo>
