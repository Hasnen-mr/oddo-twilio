<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_partner_form_twilio_call" model="ir.ui.view">
        <field name="name">res.partner.form.twilio.call</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="options">{'enable_dialer_call': True}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inject twilio_call_button into Contacts List View -->
    <record id="view_partner_tree_twilio_call" model="ir.ui.view">
        <field name="name">res.partner.tree.twilio.call</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="widget">twilio_call_button</attribute>
            </xpath>
        </field>
    </record>

</odoo>
