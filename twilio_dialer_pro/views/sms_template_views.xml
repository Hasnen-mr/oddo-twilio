<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- SMS Template List View -->
    <record id="view_twilio_sms_template_list" model="ir.ui.view">
        <field name="name">twilio.sms.template.list</field>
        <field name="model">twilio.sms.template</field>
        <field name="arch" type="xml">
            <tree string="SMS Templates" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="body"/>
                <field name="description" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- SMS Template Form View -->
    <record id="view_twilio_sms_template_form" model="ir.ui.view">
        <field name="name">twilio.sms.template.form</field>
        <field name="model">twilio.sms.template</field>
        <field name="arch" type="xml">
            <form string="SMS Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Appointment Confirmation"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Template Content">
                        <field name="body" placeholder="Type message template body..." widget="textarea" rows="4"/>
                        <field name="description" placeholder="Internal notes about when to use this template..."/>
                    </group>

                    <group string="Available Variables">
                        <div class="alert alert-info w-100" role="alert">
                            <p class="fw-bold mb-1">Click or copy any variable into your template body:</p>
                            <div class="row small">
                                <div class="col-md-6">
                                    <ul class="list-unstyled mb-0">
                                        <li><code>{{contact_name}}</code> — Contact Full Name</li>
                                        <li><code>{{first_name}}</code> — Contact First Name</li>
                                        <li><code>{{last_name}}</code> — Contact Last Name</li>
                                        <li><code>{{phone}}</code> — Phone Number</li>
                                        <li><code>{{mobile}}</code> — Mobile Number</li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <ul class="list-unstyled mb-0">
                                        <li><code>{{company}}</code> — Company / Parent Partner</li>
                                        <li><code>{{job_title}}</code> — Job Position</li>
                                        <li><code>{{email}}</code> — Email Address</li>
                                        <li><code>{{user}}</code> — Current User Name</li>
                                        <li><code>{{today}}</code> — Today Date (YYYY-MM-DD)</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SMS Template Search View -->
    <record id="view_twilio_sms_template_search" model="ir.ui.view">
        <field name="name">twilio.sms.template.search</field>
        <field name="model">twilio.sms.template</field>
        <field name="arch" type="xml">
            <search string="SMS Templates">
                <field name="name"/>
                <field name="category_id"/>
                <field name="body"/>
                <field name="description"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                </group>
</search>
        </field>
    </record>

    <!-- Action for SMS Templates -->
    <record id="action_twilio_sms_template" model="ir.actions.act_window">
        <field name="name">SMS Templates</field>
        <field name="res_model">twilio.sms.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_twilio_sms_template_search"/>
    </record>

    <!-- ── Template Categories Views ────────────────────────────────────────── -->
    <record id="view_twilio_sms_template_category_list" model="ir.ui.view">
        <field name="name">twilio.sms.template.category.list</field>
        <field name="model">twilio.sms.template.category</field>
        <field name="arch" type="xml">
            <tree string="Template Categories" editable="bottom">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="action_twilio_sms_template_category" model="ir.actions.act_window">
        <field name="name">Template Categories</field>
        <field name="res_model">twilio.sms.template.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Quick Replies Views ──────────────────────────────────────────────── -->
    <record id="view_twilio_sms_quick_reply_list" model="ir.ui.view">
        <field name="name">twilio.sms.quick.reply.list</field>
        <field name="model">twilio.sms.quick.reply</field>
        <field name="arch" type="xml">
            <tree string="Quick Replies" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="body"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_twilio_sms_quick_reply" model="ir.actions.act_window">
        <field name="name">Quick Replies</field>
        <field name="res_model">twilio.sms.quick.reply</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
